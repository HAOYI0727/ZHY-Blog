---
import { Icon } from "astro-icon/components";

import { profileConfig, siteConfig } from "@/config";
import { sortedAlbums } from "@utils/albums";
import { sortedMoments } from "@utils/diary";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { getCategoryList, getSortedPostsList } from "@utils/post";
import { getCategoryUrl, pathsEqual, url } from "@utils/url";

const wallpaperSource = siteConfig.wallpaper.src;
const desktopImages = typeof wallpaperSource === "string"
    ? [wallpaperSource]
    : Array.isArray(wallpaperSource)
        ? wallpaperSource
        : [wallpaperSource.desktop || []].flat();
const mobileImages = typeof wallpaperSource === "object" && !Array.isArray(wallpaperSource)
    ? [wallpaperSource.mobile || []].flat()
    : desktopImages;

const allPosts = await getSortedPostsList();
const categories = await getCategoryList();
const visibleAlbumCount = sortedAlbums.filter((album) => album.visible).length;
const allCategories = categories.slice().sort((a, b) => b.count - a.count);
const maxCategoryCount = Math.max(...allCategories.map((category) => category.count), 1);
const publishedYears = allPosts.map((post) => post.data.published.getFullYear());
const yearRange = publishedYears.length
    ? `${Math.min(...publishedYears)}—${Math.max(...publishedYears)}`
    : "—";
const primaryPortals = [
    {
        href: "/posts/",
        icon: "material-symbols:article-outline-rounded",
        label: i18n(I18nKey.posts),
        description: i18n(I18nKey.postsDescription),
        meta: `${allPosts.length} ${i18n(I18nKey.postsCount)}`,
        tone: "violet",
    },
    {
        href: "/archive/",
        icon: "material-symbols:calendar-month-outline-rounded",
        label: i18n(I18nKey.archive),
        description: i18n(I18nKey.archiveDescription),
        meta: yearRange,
        tone: "purple",
    },
    {
        href: "/albums/",
        icon: "material-symbols:photo-library-outline-rounded",
        label: i18n(I18nKey.albums),
        description: i18n(I18nKey.albumsSubtitle),
        meta: `${visibleAlbumCount} ${i18n(I18nKey.albumsCount)}`,
        tone: "cyan",
    },
    {
        href: "/diary/",
        icon: "material-symbols:menu-book-outline-rounded",
        label: i18n(I18nKey.diary),
        description: i18n(I18nKey.diarySubtitle),
        meta: `${sortedMoments.length} ${i18n(I18nKey.diaryCount)}`,
        tone: "blue",
    },
];
const secondaryPortals = [
    {
        href: "/projects/",
        icon: "material-symbols:work",
        label: i18n(I18nKey.projects),
        description: i18n(I18nKey.projectsSubtitle),
        tone: "blue",
    },
    {
        href: "/skills/",
        icon: "material-symbols:psychology-outline-rounded",
        label: i18n(I18nKey.skills),
        description: i18n(I18nKey.skillsSubtitle),
        tone: "violet",
    },
    {
        href: "/timeline/",
        icon: "material-symbols:timeline",
        label: i18n(I18nKey.timeline),
        description: i18n(I18nKey.timelineSubtitle),
        tone: "indigo",
    },
    {
        href: "/about/",
        icon: "material-symbols:person-outline-rounded",
        label: i18n(I18nKey.about),
        description: `${i18n(I18nKey.welcomeMeetAuthor)} ${profileConfig.name}`,
        tone: "cyan",
    },
];
const homePath = url("/");
const isHomePage = pathsEqual(Astro.url.pathname, homePath);
// 欢迎导航只复用网站当前的首张壁纸，避免重复解码整组轮播图拖慢首屏。
const slides = desktopImages.slice(0, 1).map((desktop, index) => ({
    desktop,
    mobile: mobileImages[index % Math.max(mobileImages.length, 1)] || desktop,
}));
---

<!--
    刷新和所有“主页”入口都应直接显示主页。
    这段内联脚本在欢迎页节点创建前运行，避免 Safari 刷新时闪现导航层。
-->
<script is:inline>
    (() => {
        const directHomeQuery = new URL(window.location.href).searchParams.get("view") === "home";
        const navigationEntry = performance.getEntriesByType("navigation")[0];
        const isReload = navigationEntry && navigationEntry.type === "reload";
        if (directHomeQuery || isReload) document.documentElement.classList.add("welcome-direct-home");
    })();
</script>

<section
    id="welcome-gateway"
    class="welcome-gateway fixed inset-0 z-[1000] isolate flex min-h-[100svh] items-start justify-center overflow-x-hidden overflow-y-auto px-3 py-3 sm:px-5 sm:py-5 lg:items-center"
    role="dialog"
    aria-modal="true"
    aria-labelledby="welcome-title"
    data-welcome-gateway
    data-home-path={homePath}
    hidden={!isHomePage}
>
    <div class="welcome-slides fixed inset-0 -z-40" aria-hidden="true">
        {slides.map((slide, index) => (
            <span
                style={`--slide-desktop:url('${slide.desktop}');--slide-mobile:url('${slide.mobile}');--slide-index:${index};`}
            ></span>
        ))}
    </div>
    <div class="welcome-dreamscape fixed inset-0 -z-30" aria-hidden="true"></div>

    <div class="welcome-shell-wrap mx-auto my-auto w-full max-w-[92rem] rounded-[2rem] sm:rounded-[2.6rem]">
        <div class="welcome-shell relative overflow-hidden rounded-[calc(2rem-1px)] sm:rounded-[calc(2.6rem-1px)]">
            <div class="welcome-glass-shine absolute inset-0 pointer-events-none" aria-hidden="true"></div>
            <div class="welcome-inner-glow absolute pointer-events-none" aria-hidden="true"></div>
            <div class="welcome-scanline absolute inset-x-0 pointer-events-none" aria-hidden="true"></div>
            <span class="welcome-corner welcome-corner-tl" aria-hidden="true"></span>
            <span class="welcome-corner welcome-corner-tr" aria-hidden="true"></span>
            <span class="welcome-corner welcome-corner-bl" aria-hidden="true"></span>
            <span class="welcome-corner welcome-corner-br" aria-hidden="true"></span>

            <header class="welcome-topbar relative z-10 flex items-center justify-between gap-4 border-b border-white/15 px-5 py-4 sm:px-8 sm:py-5 lg:px-10">
                <div class="flex min-w-0 items-center gap-3">
                    <div class="welcome-avatar">
                        <img src={profileConfig.avatar} alt="" width="44" height="44" loading="eager" />
                        <span aria-hidden="true"></span>
                    </div>
                    <div class="min-w-0">
                        <p class="truncate text-sm font-semibold tracking-wide">{siteConfig.title}</p>
                        <p class="mt-0.5 truncate text-[0.65rem] tracking-[0.12em] text-white/48">A UNIVERSE OF IDEAS · BY {profileConfig.name.toUpperCase()}</p>
                    </div>
                </div>

                <div class="welcome-live hidden items-center gap-2 rounded-full border border-white/15 bg-white/[0.07] px-3.5 py-2 text-[0.65rem] tracking-[0.12em] text-white/60 md:flex">
                    <i aria-hidden="true"></i>
                    KNOWLEDGE BASE IS GROWING
                </div>

                <button id="welcome-skip" type="button" class="welcome-skip" aria-label={i18n(I18nKey.welcomeSkipLabel)}>
                    <span class="hidden sm:inline">{i18n(I18nKey.welcomeSkip)}</span>
                    <Icon name="material-symbols:close-rounded" />
                </button>
            </header>

            <div class="welcome-content relative z-10 grid lg:grid-cols-[minmax(0,1.05fr)_minmax(28rem,0.95fr)]">
                <section class="welcome-hero relative flex flex-col justify-between overflow-hidden p-6 sm:p-9 lg:min-h-[43rem] lg:p-10 xl:p-12">
                    <div class="welcome-hero-grid absolute inset-0 -z-10" aria-hidden="true"></div>
                    <div class="welcome-theme-ribbon" aria-hidden="true">
                        <span></span><span></span><span></span>
                    </div>
                    <div class="welcome-floating-orb welcome-floating-orb-a absolute" aria-hidden="true">
                        <span>AI</span>
                    </div>
                    <div class="welcome-floating-orb welcome-floating-orb-b absolute" aria-hidden="true">
                        <Icon name="material-symbols:auto-awesome-rounded" />
                    </div>

                    <div>
                        <div class="welcome-badge">
                            <Icon name="material-symbols:explore-outline-rounded" />
                            <span>WELCOME, CURIOUS MIND</span>
                            <i></i>
                        </div>

                        <p id="welcome-title" class="welcome-title">
                            <span>{i18n(I18nKey.welcomeHeadlineLead)}</span>
                            <span class="welcome-title-gradient">{i18n(I18nKey.welcomeHeadlineAccent)}</span>
                        </p>

                        <p class="welcome-lead">
                            {i18n(I18nKey.welcomeIntro)}
                        </p>

                        <dl class="welcome-stats">
                            <div>
                                <dt>Articles</dt>
                                <dd><strong>{allPosts.length}</strong><span>{i18n(I18nKey.welcomeDeepContent)}</span></dd>
                            </div>
                            <div>
                                <dt>Topics</dt>
                                <dd><strong>{categories.length}</strong><span>{i18n(I18nKey.welcomeKnowledgeAreas)}</span></dd>
                            </div>
                            <div>
                                <dt>Journey</dt>
                                <dd><strong>{yearRange}</strong><span>{i18n(I18nKey.welcomeUpdating)}</span></dd>
                            </div>
                        </dl>
                    </div>

                    <div class="mt-9">
                        <div class="welcome-topics" aria-label={i18n(I18nKey.welcomeAllCategories)}>
                            <span class="welcome-mini-label">{i18n(I18nKey.welcomeAllCategories)} · {allCategories.length} {i18n(I18nKey.welcomeKnowledgePlanets)}</span>
                            <div class="welcome-topic-bubbles">
                                {allCategories.map((category, index) => (
                                    <a
                                        href={getCategoryUrl(category.name)}
                                        data-welcome-link
                                        class="welcome-topic"
                                        style={`--topic-index:${index};--bubble-delay:${index * -0.72}s;--bubble-size:${(4.05 + (category.count / maxCategoryCount) * 1.05).toFixed(2)}rem`}
                                    >
                                        <i></i>
                                        {category.name.replaceAll("_", " ")}
                                        <span>{category.count}</span>
                                    </a>
                                ))}
                            </div>
                        </div>

                        <div class="welcome-actions">
                            <button id="welcome-enter" type="button" class="welcome-primary">
                                <span>
                                    <small>START EXPLORING</small>
                                    <strong>{i18n(I18nKey.welcomeEnterBlog)}</strong>
                                </span>
                                <i><Icon name="material-symbols:arrow-forward-rounded" /></i>
                            </button>
                            <a href={url("/posts/")} data-welcome-link class="welcome-secondary">
                                <Icon name="material-symbols:library-books-outline-rounded" />
                                {i18n(I18nKey.postsAll)}
                                <span>{allPosts.length}</span>
                            </a>
                        </div>
                    </div>
                </section>

                <aside class="welcome-explore border-t border-white/15 bg-white/[0.035] p-5 sm:p-7 lg:border-l lg:border-t-0 lg:p-8" aria-label={i18n(I18nKey.welcomeContentGuide)}>
                    <div class="welcome-path-head">
                        <div>
                            <span class="welcome-mini-label">{i18n(I18nKey.welcomeQuickPortal)}</span>
                            <h2>{i18n(I18nKey.welcomeChoosePath)}</h2>
                        </div>
                        <Icon name="material-symbols:alt-route-rounded" />
                    </div>
                    <p class="welcome-path-intro">从深度文章到生活切片，按你此刻的兴趣进入这座持续生长的个人知识宇宙。</p>

                    <nav class="welcome-portals" aria-label={i18n(I18nKey.quickNavigation)}>
                        <div class="welcome-primary-portals">
                            {primaryPortals.map((portal, index) => (
                                <a href={url(portal.href)} data-welcome-link class="welcome-portal-major" data-tone={portal.tone}>
                                    <span class="welcome-portal-index">0{index + 1}</span>
                                    <i class="welcome-portal-icon"><Icon name={portal.icon} /></i>
                                    <span class="welcome-portal-copy">
                                        <strong>{portal.label}</strong>
                                        <small>{portal.description}</small>
                                    </span>
                                    <span class="welcome-portal-meta">{portal.meta}</span>
                                    <i class="welcome-portal-arrow"><Icon name="material-symbols:arrow-outward-rounded" /></i>
                                </a>
                            ))}
                        </div>

                        <div class="welcome-secondary-label">
                            <span>MORE TO DISCOVER</span>
                            <i aria-hidden="true"></i>
                        </div>

                        <div class="welcome-secondary-portals">
                            {secondaryPortals.map((portal, index) => (
                                <a href={url(portal.href)} data-welcome-link class="welcome-portal-minor" data-tone={portal.tone}>
                                    <i><Icon name={portal.icon} /></i>
                                    <span>
                                        <strong>{portal.label}</strong>
                                        <small>{portal.description}</small>
                                    </span>
                                    <b>0{index + 5}</b>
                                </a>
                            ))}
                        </div>
                    </nav>

                    <div class="welcome-search-tip">
                        <span><Icon name="material-symbols:search-rounded" /></span>
                        <p><strong>{i18n(I18nKey.welcomeSearchTitle)}</strong><small>{i18n(I18nKey.welcomeSearchHint)}</small></p>
                        <Icon name="material-symbols:keyboard-command-key" />
                    </div>
                </aside>
            </div>
        </div>
    </div>
</section>

<script>
    function initWelcomeGateway() {
        const gateway = document.querySelector<HTMLElement>("[data-welcome-gateway]");
        if (!gateway || gateway.dataset.initialized === "true") return;
        gateway.dataset.initialized = "true";
        let closeTimer = 0;

        const normalizePath = (path: string) => path.replace(/^\/+|\/+$/g, "").toLowerCase();
        const isHomePath = () => normalizePath(window.location.pathname) === normalizePath(gateway.dataset.homePath || "/");

        const hideGateway = (moveFocus = false, immediate = false, usePortalReveal = false) => {
            window.clearTimeout(closeTimer);
            if (!immediate) {
                gateway.classList.add(usePortalReveal ? "is-opening" : "is-leaving");
                if (usePortalReveal) document.documentElement.classList.add("welcome-revealing");
            }
            const finish = () => {
                gateway.hidden = true;
                gateway.classList.remove("is-leaving", "is-opening");
                document.body.classList.remove("welcome-open");
                window.setTimeout(() => document.documentElement.classList.remove("welcome-revealing"), 680);
                if (moveFocus) document.getElementById("swup-container")?.focus({ preventScroll: true });
            };
            if (immediate) finish();
            else closeTimer = window.setTimeout(finish, usePortalReveal ? 440 : 320);
        };

        const showGateway = () => {
            window.clearTimeout(closeTimer);
            gateway.hidden = false;
            gateway.classList.remove("is-leaving", "is-opening");
            document.documentElement.classList.remove("welcome-revealing");
            gateway.scrollTop = 0;
            document.body.classList.add("welcome-open");
            window.setTimeout(() => document.getElementById("welcome-enter")?.focus({ preventScroll: true }), 40);
        };

        const consumeViewIntent = () => {
            const currentUrl = new URL(window.location.href);
            const view = currentUrl.searchParams.get("view");
            if (view !== "home" && view !== "welcome") return view;

            currentUrl.searchParams.delete("view");
            const cleanUrl = `${currentUrl.pathname}${currentUrl.search}${currentUrl.hash}`;
            window.history.replaceState(window.history.state, "", cleanUrl);
            return view;
        };

        const syncWithRoute = () => {
            if (!isHomePath()) {
                hideGateway(false, true);
                return;
            }
            const viewIntent = consumeViewIntent();
            const navigationEntry = performance.getEntriesByType("navigation")[0] as PerformanceNavigationTiming | undefined;
            const isReload = navigationEntry?.type === "reload";
            if (viewIntent === "home" || (isReload && viewIntent !== "welcome")) {
                hideGateway(true, true);
                document.documentElement.classList.remove("welcome-direct-home");
                return;
            }
            document.documentElement.classList.remove("welcome-direct-home");
            showGateway();
        };

        document.getElementById("welcome-enter")?.addEventListener("click", (event) => {
            const button = event.currentTarget as HTMLElement;
            const rect = button.getBoundingClientRect();
            gateway.style.setProperty("--exit-x", `${rect.left + rect.width / 2}px`);
            gateway.style.setProperty("--exit-y", `${rect.top + rect.height / 2}px`);
            hideGateway(true, false, true);
        });
        document.getElementById("welcome-skip")?.addEventListener("click", () => hideGateway(true));
        gateway.querySelectorAll<HTMLAnchorElement>("[data-welcome-link]").forEach((link) => {
            link.addEventListener("click", () => hideGateway(false));
        });

        gateway.addEventListener("keydown", (event) => {
            if (event.key === "Escape") hideGateway(true);
            if (event.key === "Tab") {
                const focusable = Array.from(gateway.querySelectorAll<HTMLElement>("button:not([disabled]), a[href]"));
                const first = focusable[0];
                const last = focusable[focusable.length - 1];
                if (!first || !last) return;
                if (event.shiftKey && document.activeElement === first) {
                    event.preventDefault();
                    last.focus();
                } else if (!event.shiftKey && document.activeElement === last) {
                    event.preventDefault();
                    first.focus();
                }
            }
        });

        const bindSwup = () => {
            if (!window.swup?.hooks || gateway.dataset.swupBound === "true") return;
            gateway.dataset.swupBound = "true";
            window.swup.hooks.on("page:view", syncWithRoute);
        };

        if (window.swup?.hooks) bindSwup();
        else document.addEventListener("swup:enable", bindSwup, { once: true });
        syncWithRoute();
    }

    initWelcomeGateway();
</script>

<style>
    :global(body.welcome-open) { overflow: hidden; }
    :global(html.welcome-direct-home) .welcome-gateway { display: none !important; }

    .welcome-gateway {
        --exit-x: 50vw;
        --exit-y: 72vh;
        --welcome-fg: 30 32 68;
        --welcome-surface: 244 247 255;
        --welcome-border: 105 111 201;
        --welcome-sky: 104 168 245;
        --welcome-mint: 139 137 235;
        --welcome-sunset: 180 132 226;
        --tech-primary: color-mix(in oklch, var(--primary) 82%, white 18%);
        --tech-cyan: oklch(0.82 0.13 calc(var(--hue) - 65));
        --tech-violet: oklch(0.73 0.18 calc(var(--hue) + 28));
        opacity: 1;
        background: transparent;
        color: rgb(var(--welcome-fg));
        transition: opacity 0.42s cubic-bezier(0.22, 1, 0.36, 1), visibility 0.42s ease;
        will-change: opacity;
    }

    :global(html.dark) .welcome-gateway {
        --welcome-fg: 242 241 255;
        --welcome-surface: 13 17 52;
        --welcome-border: 123 127 220;
        --welcome-sky: 55 105 201;
        --welcome-mint: 92 78 190;
        --welcome-sunset: 129 74 177;
    }

    .welcome-gateway.is-leaving { opacity: 0; pointer-events: none; }
    .welcome-gateway.is-opening {
        opacity: 0;
        pointer-events: none;
    }

    .welcome-gateway.is-opening .welcome-shell-wrap {
        opacity: 0;
        transform: translateY(-0.2rem) scale(1.012);
        transition: opacity 0.36s ease, transform 0.44s cubic-bezier(0.22, 1, 0.36, 1);
    }

    :global(html.welcome-revealing #banner-wrapper) {
        animation: welcome-banner-reveal 0.58s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    :global(html.welcome-revealing #top-row) {
        animation: welcome-navbar-reveal 0.46s 0.05s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .welcome-slides span {
        position: absolute;
        inset: 0;
        background-image: var(--slide-mobile);
        background-position: center;
        background-size: cover;
        opacity: 0;
    }

    .welcome-slides span:first-child { opacity: 1; }
    .welcome-slides span:not(:first-child) { display: none; }

    .welcome-dreamscape {
        background:
            radial-gradient(circle at 14% 12%, rgb(113 183 255 / 30%), transparent 38%),
            radial-gradient(circle at 88% 84%, rgb(193 145 242 / 27%), transparent 40%),
            linear-gradient(125deg, rgb(225 239 255 / 42%), rgb(241 229 255 / 34%));
    }

    :global(html.dark) .welcome-dreamscape {
        background:
            radial-gradient(circle at 14% 12%, rgb(47 91 190 / 34%), transparent 38%),
            radial-gradient(circle at 88% 84%, rgb(111 55 163 / 34%), transparent 42%),
            linear-gradient(125deg, rgb(4 15 53 / 66%), rgb(44 15 68 / 58%));
    }

    .welcome-aurora {
        border-radius: 50%;
        filter: blur(70px);
        opacity: 0.35;
        pointer-events: none;
        transition: transform 0.25s ease-out;
    }

    .welcome-aurora-one {
        left: -8rem;
        top: 10%;
        height: 28rem;
        width: 28rem;
        background: rgb(70 118 232 / 62%);
        transform: translate(var(--parallax-x), var(--parallax-y));
        animation: welcome-float-a 10s ease-in-out infinite;
    }

    .welcome-aurora-two {
        bottom: -10rem;
        right: 3%;
        height: 32rem;
        width: 32rem;
        background: rgb(144 83 214 / 52%);
        transform: translate(calc(var(--parallax-x) * -1), calc(var(--parallax-y) * -1));
        animation: welcome-float-b 12s ease-in-out infinite;
    }

    .welcome-aurora-three {
        right: 21%;
        top: -10rem;
        height: 24rem;
        width: 24rem;
        background: rgb(108 162 255 / 42%);
        animation: welcome-float-c 13s ease-in-out infinite;
    }

    .welcome-sparkles i {
        position: absolute;
        left: var(--sparkle-x);
        top: var(--sparkle-y);
        height: var(--sparkle-size);
        width: var(--sparkle-size);
        border-radius: 50%;
        background: white;
        box-shadow: 0 0 0.55rem rgb(170 210 255 / 90%);
        opacity: 0.18;
        animation: welcome-twinkle var(--sparkle-duration) ease-in-out var(--sparkle-delay) infinite;
    }

    .welcome-shell-wrap {
        position: relative;
        padding: 1px;
        overflow: hidden;
        background: linear-gradient(125deg, rgb(var(--welcome-sky) / 52%), rgb(var(--welcome-mint) / 32%) 48%, rgb(var(--welcome-sunset) / 50%));
        box-shadow: 0 1.5rem 5rem rgb(34 31 92 / 22%), 0 0 3.5rem rgb(var(--welcome-sunset) / 14%);
    }

    .welcome-shell-wrap::before {
        display: none;
    }

    .welcome-shell {
        background:
            linear-gradient(132deg, rgb(var(--welcome-surface) / 68%), rgb(239 232 255 / 56%)),
            linear-gradient(120deg, rgb(var(--welcome-sky) / 14%), transparent 48%, rgb(var(--welcome-sunset) / 15%));
        box-shadow: inset 0 1px 0 rgb(var(--welcome-border) / 12%);
        backdrop-filter: blur(18px) saturate(1.06);
        -webkit-backdrop-filter: blur(18px) saturate(1.06);
    }

    :global(html.dark) .welcome-shell {
        background:
            linear-gradient(132deg, rgb(var(--welcome-surface) / 78%), rgb(39 18 70 / 70%)),
            linear-gradient(120deg, rgb(var(--welcome-sky) / 16%), transparent 48%, rgb(var(--welcome-sunset) / 17%));
    }

    .welcome-scanline {
        display: none;
    }

    .welcome-corner {
        position: absolute;
        z-index: 21;
        height: 1.15rem;
        width: 1.15rem;
        pointer-events: none;
        opacity: 0.55;
    }

    .welcome-corner-tl { left: 0.75rem; top: 0.75rem; border-left: 1px solid var(--tech-cyan); border-top: 1px solid var(--tech-cyan); }

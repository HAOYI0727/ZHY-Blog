---
import { Icon } from "astro-icon/components";

import { i18n } from "@i18n/translation";
import I18nKey from "@i18n/i18nKey";


interface Props {
    id: string;
    name?: string;
    isCollapsed?: boolean;
    collapsedHeight?: string;
    class?: string;
    style?: string;
}
const { id, name, isCollapsed, collapsedHeight, style } = Astro.props;
const className = Astro.props.class;
---

<widget-layout id={id} data-id={id} data-swup-persist={id} data-is-collapsed={String(isCollapsed)} class:list={["widget-layout-card pb-4 card-base", className]} style={style}>
    <div class="widget-layout-heading font-bold transition text-lg text-neutral-900 dark:text-neutral-100 relative ml-8 mt-4 mb-2">{name}</div>
    <div id={`${id}-wrapper`} class:list={["collapse-wrapper px-4 overflow-hidden", {"collapsed": isCollapsed}]}>
        <slot></slot>
    </div>
    {isCollapsed && <div class="expand-btn px-4 -mb-2">
        <button class="btn-plain rounded-lg w-full h-9">
            <div class="text-(--primary) flex items-center justify-center gap-2 -translate-x-2">
                <Icon name="material-symbols:more-horiz" class="text-[1.75rem]"></Icon> {i18n(I18nKey.more)}
            </div>
        </button>
    </div>}
</widget-layout>

<style define:vars={{ collapsedHeight }}>
    .widget-layout-card {
        position: relative;
        overflow: hidden;
        border: 1px solid color-mix(in srgb, var(--primary) 11%, var(--line-divider));
        background:
            linear-gradient(145deg, color-mix(in oklch, var(--primary) 3%, transparent), transparent 48%),
            var(--card-bg);
        box-shadow: 0 .5rem 1.8rem color-mix(in srgb, var(--primary) 5%, transparent);
    }
    .widget-layout-card::before {
        position: absolute;
        top: 0;
        left: 1.1rem;
        right: 1.1rem;
        height: 2px;
        content: "";
        background: linear-gradient(90deg, transparent, color-mix(in oklch, var(--primary) 72%, transparent), transparent);
        opacity: .65;
    }
    .widget-layout-heading::before {
        position: absolute;
        top: .35rem;
        left: -1rem;
        width: .25rem;
        height: 1.15rem;
        border-radius: 999px;
        content: "";
        background: var(--primary);
        box-shadow: 0 0 .75rem color-mix(in oklch, var(--primary) 62%, transparent);
    }
    .widget-layout-card:hover { border-color: color-mix(in srgb, var(--primary) 24%, var(--line-divider)); }
    .collapsed {
        height: var(--collapsedHeight);
    }
</style>

<script>
    class WidgetLayout extends HTMLElement {
        constructor() {
            super();

            if (this.dataset.isCollapsed !== "true")
                return;

            const id = this.dataset.id;
            const btn = this.querySelector('.expand-btn');
            const wrapper = this.querySelector(`#${id}-wrapper`)
            btn!.addEventListener('click', () => {
                wrapper!.classList.remove('collapsed');
                btn!.classList.add('hidden');
            })
        }
    }

    if (!customElements.get("widget-layout")) {
        customElements.define("widget-layout", WidgetLayout);
    }
</script>

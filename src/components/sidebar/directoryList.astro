---
import type { DirectoryNode } from "@utils/directory";

interface Props { nodes: DirectoryNode[]; currentPath: string; }
const { nodes, currentPath } = Astro.props;
const normalize = (value = "/") => value.replace(/\/$/, "") || "/";
const containsCurrent = (node: DirectoryNode): boolean => node.type === "file"
    ? normalize(node.url) === normalize(currentPath)
    : !!node.children?.some(containsCurrent);
---

<ul class="directory-list">
    {nodes.map((node) => (
        <li>
            {node.type === "folder" ? (
                <details open={containsCurrent(node)}>
                    <summary>
                        <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M20 6h-8l-2-2H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2Z"/></svg>
                        <span>{node.name}</span>
                        <svg class="directory-chevron" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
                    </summary>
                    {node.children && <Astro.self nodes={node.children} {currentPath} />}
                </details>
            ) : (
                <a href={node.url} aria-current={containsCurrent(node) ? "page" : undefined}>
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Zm4 18H6V4h7v5h5v11Z"/></svg>
                    <span>{node.name}</span>
                </a>
            )}
        </li>
    ))}
</ul>

<style>
    .directory-list{display:flex;min-width:0;flex-direction:column;list-style:none;margin:0;padding:0 0 0 .75rem;color:var(--text-color)}:global(.directory-container>.directory-list){padding-left:0;padding-bottom:.5rem}li{min-width:0}summary,a{display:flex;min-width:0;align-items:center;gap:.375rem;margin-block:.125rem;padding:.375rem .5rem;border-radius:.375rem;color:color-mix(in srgb,var(--text-color) 78%,transparent);cursor:pointer;transition:color 160ms ease,background-color 160ms ease}summary{list-style:none;font-weight:500}summary::-webkit-details-marker{display:none}summary:hover,a:hover,a[aria-current="page"]{color:var(--primary);background:var(--btn-plain-bg-hover)}svg{width:1rem;height:1rem;flex:none}span{min-width:0;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.directory-chevron{transition:rotate 160ms ease}details[open]>summary .directory-chevron{rotate:90deg}@media(prefers-reduced-motion:reduce){summary,a,.directory-chevron{transition:none}}
</style>

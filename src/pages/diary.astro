---
// src/pages/diary.astro
import { LinkPresets } from "@constants/link-presets";
import { LinkPreset } from "@/types/config";
import { sortedMoments, groupMomentsByFolder, getCoverImage } from "@utils/diary";
import { i18n } from "@i18n/translation";
import I18nKey from "@i18n/i18nKey";
import GridLayout from "@layouts/grid.astro";
import BackwardButton from "@components/backwardButton.astro";
import ImageWrapper from "@components/common/imageWrapper.astro";

const pageTitle = LinkPresets[LinkPreset.Diary].name;
const pageDescription = LinkPresets[LinkPreset.Diary].description;

const groupedMoments = groupMomentsByFolder(sortedMoments);
const totalCount = sortedMoments.length;
---

<GridLayout title={pageTitle} description={pageDescription}>
    <div class="diary-shell flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
        <div class="diary-panel card-base z-10 px-4 py-4 md:px-6 md:py-5 relative w-full">
            <BackwardButton currentPath={Astro.url.pathname} />

            <header class="diary-header mb-8">
                <div>
                    <p class="diary-eyebrow"><span></span> PERSONAL NOTES</p>
                    <h1 class="text-3xl font-bold text-90 mb-2">{pageTitle}</h1>
                    <p class="diary-description">{pageDescription}</p>
                </div>
                <div class="diary-count"><strong>{totalCount}</strong><span>{i18n(I18nKey.diaryCount)}</span></div>
            </header>

            <div class="space-y-12">
                {groupedMoments.map(group => (
                    <section class="folder-section">
                        <h2 class="diary-section-title text-2xl font-bold text-90 mb-6 flex items-center gap-3">
                            {group.folder}
                            <span class="text-sm text-60 font-normal">({group.items.length})</span>
                        </h2>

                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                            {group.items.map(moment => {
                                const cover = getCoverImage(moment);
                                return (
                                    <article class="diary-card group rounded-lg overflow-hidden shadow-sm hover:shadow-md transition-all duration-300" data-card-view-id={`/diary/${moment.folder ? moment.folder + '/' : ''}${moment.id}/`}>
                                        {/* ✅ a 标签包裹整个卡片 */}
                                        <a href={`/diary/${moment.folder ? moment.folder + '/' : ''}${moment.id}/`} class="block">
                                            <!-- 封面 -->
                                            <div class="diary-cover aspect-4/3 overflow-hidden">
                                                {cover ? (
                                                    <ImageWrapper
                                                        src={cover}
                                                        basePath={moment.basePath}
                                                        alt={moment.title || i18n(I18nKey.diaryImage)}
                                                        class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                                                    />
                                                ) : (
                                                    <div class="w-full h-full flex items-center justify-center diary-cover-empty">
                                                        <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                                        </svg>
                                                    </div>
                                                )}
                                            </div>
                                            <!-- 信息区域（现在在 a 标签内部） -->
                                            <div class="p-4">
                                                <h3 class="font-bold text-lg text-90 mb-2 group-hover:text-(--primary) transition-colors line-clamp-1">
                                                    {moment.title || i18n(I18nKey.diaryUntitled)}
                                                </h3>
                                                <p class="text-75 text-sm mb-3 line-clamp-2">
                                                    {moment.content.replace(/\n/g, ' ')}
                                                </p>
                                                <div class="diary-meta flex items-center justify-between text-xs text-60">
                                                    <div class="flex items-center gap-3">
                                                        <time>{new Date(moment.date).toLocaleDateString('zh-CN')}</time>
                                                        <span class="diary-card-views flex items-center gap-1" aria-label="浏览量">
                                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                                                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" />
                                                                <circle cx="12" cy="12" r="2.4" />
                                                            </svg>
                                                            <span data-view-count>—</span>
                                                        </span>
                                                    </div>
                                                    {moment.images && moment.images.length > 0 && (
                                                        <span class="flex items-center gap-1">
                                                            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                                                                <path fill-rule="evenodd" d="M4 5a2 2 0 00-2 2v8a2 2 0 002 2h12a2 2 0 002-2V7a2 2 0 00-2-2h-1.586a1 1 0 01-.707-.293l-1.121-1.121A2 2 0 0011.172 3H8.828a2 2 0 00-1.414.586L6.293 4.707A1 1 0 015.586 5H4zm6 9a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"></path>
                                                            </svg>
                                                            {moment.images.length}
                                                        </span>
                                                    )}
                                                </div>
                                            </div>
                                        </a>
                                    </article>
                                );
                            })}
                        </div>
                    </section>
                ))}
            </div>

            {totalCount === 0 && (
                <div class="text-center py-12 text-60">
                    <p>{i18n(I18nKey.diaryEmpty)}</p>
                </div>
            )}
        </div>
    </div>
</GridLayout>

<style>
    .diary-panel { border: 1px solid color-mix(in srgb, var(--primary) 15%, var(--line-divider)); background: radial-gradient(circle at 5% 0%, color-mix(in oklch, var(--primary) 10%, transparent), transparent 27rem), var(--card-bg); }
    .diary-header { display:flex; align-items:flex-end; justify-content:space-between; gap:1rem; padding:1rem; border:1px solid color-mix(in srgb,var(--primary) 14%,transparent); border-radius:1rem; background:linear-gradient(120deg,color-mix(in oklch,var(--primary) 8%,transparent),transparent 65%); }
    .diary-eyebrow { display:flex; align-items:center; gap:.45rem; margin:0 0 .45rem; color:var(--primary); font-size:.68rem; font-weight:800; letter-spacing:.15em; }
    .diary-eyebrow span { width:.42rem; height:.42rem; border-radius:999px; background:var(--primary); box-shadow:0 0 .7rem color-mix(in oklch,var(--primary) 65%,transparent); }
    .diary-description { margin:0; color:var(--text-secondary); }
    .diary-count { display:flex; min-width:5.2rem; min-height:4.2rem; flex-direction:column; align-items:center; justify-content:center; border:1px solid color-mix(in srgb,var(--primary) 25%,transparent); border-radius:.85rem; background:color-mix(in oklch,var(--primary) 8%,var(--card-bg)); }
    .diary-count strong { color:var(--primary); font-size:1.45rem; line-height:1; }
    .diary-count span { margin-top:.3rem; color:var(--text-tertiary); font-size:.68rem; white-space:nowrap; }
    .diary-section-title { position:relative; padding-left:.85rem; }
    .diary-section-title::before { position:absolute; left:0; top:.35em; bottom:.35em; width:.25rem; border-radius:999px; content:""; background:var(--primary); box-shadow:0 0 .7rem color-mix(in oklch,var(--primary) 55%,transparent); }
    .diary-card {
        border:1px solid color-mix(in srgb,var(--primary) 13%,var(--line-divider));
        background:linear-gradient(145deg,color-mix(in oklch,var(--primary) 5%,var(--card-bg)),var(--card-bg));
        animation: fadeInUp 0.3s ease-out;
    }
    .diary-card:hover {
        translate: 0 -2px;
        border-color:color-mix(in srgb,var(--primary) 36%,var(--line-divider));
        box-shadow:0 .8rem 1.8rem color-mix(in srgb,var(--primary) 10%,transparent);
    }
    .diary-cover { background:color-mix(in oklch,var(--primary) 7%,var(--card-bg)); border-bottom:1px solid color-mix(in srgb,var(--primary) 12%,transparent); }
    .diary-cover-empty { color:color-mix(in srgb,var(--primary) 55%,var(--text-tertiary)); }
    .diary-meta { color:var(--text-tertiary); }
    .diary-meta svg { color:var(--primary); }
    .diary-card-views { color: var(--primary); font-variant-numeric: tabular-nums; }
    .diary-card-views span { color: var(--text-secondary); }
    @media (max-width:520px) { .diary-header { align-items:flex-start; } .diary-count { min-width:4.5rem; } }
    @keyframes fadeInUp {
        from { opacity: 0; translate: 0 20px; }
        to { opacity: 1; translate: 0 0; }
    }
</style>

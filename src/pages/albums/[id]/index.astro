---
import type { AlbumGroup } from "@utils/albums";
import { sortedAlbums } from "@utils/albums";
import { i18n } from "@i18n/translation";
import I18nKey from "@i18n/i18nKey";
import GridLayout from "@layouts/grid.astro";
import BackwardButton from "@components/backwardButton.astro";
import ImageWrapper from "@components/common/imageWrapper.astro";


export const getStaticPaths = async () => {
    return sortedAlbums.filter(album => album.visible).map((album) => ({
        params: { id: album.id },
        props: { album },
    }));
};


interface Props {
    album: AlbumGroup;
}

const { album } = Astro.props;
const albumIndex = sortedAlbums.findIndex((item) => item.id === album.id);
const newerAlbum = albumIndex > 0 ? sortedAlbums[albumIndex - 1] : undefined;
const olderAlbum = albumIndex >= 0 ? sortedAlbums[albumIndex + 1] : undefined;

if (!album) {
    return Astro.redirect("/404");
}
---

<GridLayout title={album.title} description={album.description || album.title}>
    <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32" data-album-page data-album-id={`/albums/${album.id}/`}>
        <div class="card-base z-10 px-9 py-6 relative w-full">
            <BackwardButton href="/albums/" text={i18n(I18nKey.albumsBackToList)} />
            <!-- 相册标题信息 -->
            <header class="album-detail-hero mb-8 rounded-(--radius-large) p-5 md:p-7">
                <div class="album-detail-hero__glow" aria-hidden="true"></div>
                <div class="relative z-10 flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
                    <div class="min-w-0">
                        <span class="album-eyebrow">STUDY NOTE · ALBUM</span>
                        <h1 class="mt-3 text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 md:text-4xl">
                            {album.title}
                        </h1>
                        {album.description && (
                            <p class="mt-3 max-w-2xl text-sm leading-7 text-neutral-600 dark:text-neutral-400 md:text-base">
                                {album.description}
                            </p>
                        )}
                    </div>
                    <div class="album-detail-stats grid grid-cols-2 gap-2 sm:grid-cols-3">
                        <div><strong>{album.photos.length}</strong><span>{album.photos.length > 1 ? i18n(I18nKey.albumsPhotosCount) : i18n(I18nKey.albumsPhotoCount)}</span></div>
                        <div data-album-views><strong>—</strong><span>浏览</span></div>
                        <div><strong>{new Date(album.date).getFullYear()}</strong><span>记录年份</span></div>
                    </div>
                </div>
                <div class="relative z-10 mt-5 flex flex-wrap items-center gap-3 border-t border-(--line-divider) pt-4 text-xs text-60">
                    <time>{new Date(album.date).toLocaleDateString('zh-CN')}</time>
                    {album.location && <span>· {album.location}</span>}
                    {album.tags && album.tags.length > 0 && (
                        <div class="flex flex-wrap gap-1.5">
                            {album.tags.map(tag => <span class="album-tag">{tag}</span>)}
                        </div>
                    )}
                </div>
            </header>
            <div class="album-view-hint mb-6 flex flex-wrap items-center justify-between gap-3 rounded-2xl px-4 py-3 text-sm text-60">
                <span><strong>沉浸式浏览</strong> · 点击笔记进入全屏，支持左右方向键、缩略图、触控滑动和滚轮缩放。</span>
                <span class="album-view-hint__key">ESC 退出</span>
            </div>
            <!-- 照片网格 -->
            <div
                class={`photo-gallery moment-images ${album.layout === 'masonry' ? 'masonry-layout' : 'grid-layout'}`}
                data-layout={album.layout || 'grid'}
                data-columns={album.columns || 3}
            >
                {album.photos.map((photo, index) => (
                    <figure class="photo-item group relative overflow-hidden rounded-lg">
                        <ImageWrapper
                            src={photo.src}
                            basePath={album.basePath}
                            alt={photo.alt}
                            class="photo-image w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 cursor-pointer"
                        />
                        <span class="photo-index" aria-hidden="true">{index + 1}</span>
                        {(photo.title || photo.description) && <figcaption class="photo-caption"><strong>{photo.title}</strong>{photo.description && <span>{photo.description}</span>}</figcaption>}
                    </figure>
                ))}
            </div>
            <nav class="album-navigation mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2" aria-label="相册导航">
                {newerAlbum ? <a href={`/albums/${newerAlbum.id}/`}><span>‹ 较新的相册</span><strong>{newerAlbum.title}</strong></a> : <span />}
                {olderAlbum && <a class="text-right" href={`/albums/${olderAlbum.id}/`}><span>较旧的相册 ›</span><strong>{olderAlbum.title}</strong></a>}
            </nav>
        </div>
    </div>
</GridLayout>

<style>
    .album-detail-hero {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        border: 1px solid color-mix(in srgb, var(--primary) 20%, var(--line-divider));
        background: linear-gradient(135deg, color-mix(in srgb, var(--primary) 12%, var(--card-bg)), color-mix(in srgb, var(--card-bg) 90%, transparent));
        box-shadow: 0 1.25rem 3rem color-mix(in srgb, var(--primary) 9%, transparent);
    }
    .album-detail-hero__glow {
        position: absolute;
        top: -8rem;
        right: 8%;
        z-index: -1;
        width: 18rem;
        height: 18rem;
        border-radius: 999px;
        background: radial-gradient(circle, var(--primary), transparent 68%);
        opacity: .2;
        filter: blur(5px);
    }
    .album-detail-stats { min-width: min(100%, 22rem); }
    .album-detail-stats > div {
        display: grid;
        gap: .15rem;
        min-width: 5rem;
        padding: .7rem .8rem;
        border: 1px solid color-mix(in srgb, var(--primary) 16%, var(--line-divider));
        border-radius: .85rem;
        background: color-mix(in srgb, var(--card-bg) 72%, transparent);
    }
    .album-detail-stats strong { color: var(--primary); font-size: 1.15rem; line-height: 1.1; }
    .album-detail-stats span { color: var(--text-secondary); font-size: .66rem; }
    .album-eyebrow { color: var(--primary); font-size: .68rem; font-weight: 800; letter-spacing: .16em; }
    .album-eyebrow::before { content: ""; display: inline-block; width: 1.5rem; height: 2px; margin-right: .45rem; vertical-align: middle; border-radius: 99px; background: var(--primary); }
    .album-tag { padding: .25rem .55rem; border: 1px solid color-mix(in srgb, var(--primary) 18%, transparent); border-radius: 999px; color: var(--primary); background: color-mix(in srgb, var(--primary) 8%, transparent); }
    .album-view-hint { border: 1px solid color-mix(in srgb, var(--primary) 20%, transparent); background: linear-gradient(90deg, color-mix(in srgb, var(--primary) 10%, var(--card-bg)), color-mix(in srgb, var(--card-bg) 90%, transparent)); box-shadow: 0 .5rem 1.5rem color-mix(in srgb, var(--primary) 7%, transparent); }
    .album-view-hint strong { color: var(--primary); }
    .album-view-hint__key { padding: .25rem .55rem; border: 1px solid color-mix(in srgb, var(--primary) 20%, transparent); border-radius: .5rem; color: var(--primary); font-size: .68rem; font-weight: 700; letter-spacing: .08em; }
    .photo-index { position: absolute; z-index: 2; top: .55rem; left: .55rem; min-width: 1.55rem; padding: .2rem .35rem; border-radius: 999px; background: rgb(0 0 0 / 48%); color: white; font-size: .68rem; text-align: center; opacity: .82; }
    .album-navigation a { display: grid; gap: .2rem; min-width: 0; padding: .85rem 1rem; border: 1px solid var(--line-divider); border-radius: .9rem; background: color-mix(in srgb, var(--btn-regular-bg) 65%, transparent); color: inherit; text-decoration: none; }
    .album-navigation a:hover { border-color: color-mix(in srgb, var(--primary) 48%, transparent); color: var(--primary); }
    .album-navigation span { color: color-mix(in srgb, currentColor 58%, transparent); font-size: .72rem; }
    .album-navigation strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: .86rem; }
    .photo-gallery {
        margin-top: 1rem;
    }

    .grid-layout {
        display: grid;
        gap: 1.15rem;
    }

    .grid-layout[data-columns="2"] {
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    }

    .grid-layout[data-columns="3"] {
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    }

    .grid-layout[data-columns="4"] {
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }

    .masonry-layout {
        columns: 2;
        column-gap: 1.15rem;
    }

    @media (min-width: 768px) {
        .masonry-layout {
            columns: 3;
        }
    }

    @media (min-width: 1280px) {
        .masonry-layout[data-columns="4"] {
            columns: 4;
        }
    }

    .masonry-layout .photo-item {
        break-inside: avoid;
        margin-bottom: 1.15rem;
    }

    .grid-layout .photo-container {
        aspect-ratio: 1;
    }

    .photo-item {
        min-height: 10rem;
        border: 1px solid color-mix(in srgb, var(--primary) 16%, var(--line-divider));
        background: color-mix(in srgb, var(--btn-regular-bg) 70%, transparent);
        box-shadow: 0 .45rem 1.2rem color-mix(in srgb, var(--primary) 8%, transparent);
        transition: transform .3s ease, border-color .3s ease, box-shadow .3s ease;
    }

    /* 列表缩略图统一为方形，点击后仍由图片预览展示原始比例。 */
    .photo-item { aspect-ratio: 1 / 1; }
    .photo-item :global(.photo-image) { width: 100%; height: 100%; object-fit: cover; object-position: center; }
    .masonry-layout .photo-item { aspect-ratio: 1 / 1; }
    .photo-item::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, transparent 55%, rgb(0 0 0 / 45%)); opacity: 0; transition: opacity 180ms ease; }
    .photo-item:hover::after { opacity: 1; }
    .photo-item:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--primary) 46%, transparent); box-shadow: 0 1rem 2rem color-mix(in srgb, var(--primary) 14%, transparent); }
    .photo-caption { position: absolute; z-index: 1; right: .75rem; bottom: .65rem; left: .75rem; display: grid; gap: .15rem; color: white; opacity: 0; transform: translateY(.35rem); transition: opacity 180ms ease, transform 180ms ease; text-shadow: 0 1px 5px rgb(0 0 0 / 65%); }
    .photo-item:hover .photo-caption { opacity: 1; transform: translateY(0); }
    .photo-caption strong { font-size: .82rem; }
    .photo-caption span { overflow: hidden; font-size: .7rem; text-overflow: ellipsis; white-space: nowrap; }

    @media (max-width: 640px) {
        .masonry-layout { columns: 1; }
        .grid-layout { grid-template-columns: 1fr !important; }
        .photo-item { min-height: 12rem; }
        .album-detail-stats { width: 100%; }
    }

    .album-views strong { color: var(--primary); font-weight: 700; }
</style>

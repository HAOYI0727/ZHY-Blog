---
// src/pages/albums.astro
import { LinkPresets } from "@constants/link-presets";
import { LinkPreset } from "@/types/config";
import { sortedAlbums, groupAlbumsByFolder } from "@utils/albums";
import { i18n } from "@i18n/translation";
import I18nKey from "@i18n/i18nKey";
import GridLayout from "@layouts/grid.astro";
import BackwardButton from "@components/backwardButton.astro";
import ImageWrapper from "@components/common/imageWrapper.astro";
import { siteConfig } from "@/config";
import { langToLocaleMap } from "@i18n/language";

const pageTitle = LinkPresets[LinkPreset.Albums].name;
const pageDescription = LinkPresets[LinkPreset.Albums].description;

// 获取所有可见相册
const visibleAlbums = sortedAlbums.filter(album => album.visible);
// 按文件夹分组
const groupedAlbums = groupAlbumsByFolder(visibleAlbums);
const totalPhotos = visibleAlbums.reduce((total, album) => total + album.photos.length, 0);
const latestAlbum = visibleAlbums[0];
---

<GridLayout title={pageTitle} description={pageDescription}>
    <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full">
            <BackwardButton currentPath={Astro.url.pathname} />
            <!-- 页面标题 -->
            <header class="album-hero mb-10 rounded-(--radius-large) p-6 md:p-8">
                <div class="album-hero__glow album-hero__glow--one" aria-hidden="true"></div>
                <div class="album-hero__glow album-hero__glow--two" aria-hidden="true"></div>
                <div class="relative z-10 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
                    <div class="max-w-2xl">
                        <span class="album-eyebrow">VISUAL ARCHIVE · STUDY NOTES</span>
                        <h1 class="mt-3 text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 md:text-4xl">
                            {pageTitle}
                        </h1>
                        <p class="mt-3 max-w-xl text-sm leading-7 text-neutral-600 dark:text-neutral-400 md:text-base">
                            {pageDescription}
                        </p>
                    </div>
                    <div class="album-hero__stats grid grid-cols-2 gap-2 sm:grid-cols-3 lg:min-w-[23rem]">
                        <div><strong>{visibleAlbums.length}</strong><span>{i18n(I18nKey.albumsCount)}</span></div>
                        <div><strong>{totalPhotos}</strong><span>{i18n(I18nKey.albumsPhotosCount)}</span></div>
                        <div class="col-span-2 sm:col-span-1"><strong>{latestAlbum ? new Date(latestAlbum.date).getFullYear() : "—"}</strong><span>最近更新</span></div>
                    </div>
                </div>
            </header>

            <!-- 按分组展示 -->
            <div class="space-y-12">
                {groupedAlbums.map(group => (
                    <section class="folder-section">
                        <div class="album-section-heading mb-5 flex items-center gap-3">
                            <span class="album-section-heading__mark" aria-hidden="true"></span>
                            <h2 class="text-2xl font-bold text-90">{group.folder}</h2>
                            <span class="rounded-full px-2.5 py-1 text-xs font-semibold text-(--primary)">({group.items.length})</span>
                        </div>
                        
                        <!-- 相册网格 -->
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                            {group.items.map(album => (
                                <article
                                    class="album-card group rounded-(--radius-large) overflow-hidden shadow-sm transition-all duration-300"
                                >
                                    <a href={`/albums/${album.id}/`} class="block">
                                        <!-- 封面图片 -->
                                        <div class="album-cover relative aspect-4/3 overflow-hidden">
                                            <ImageWrapper
                                                src={album.cover}
                                                basePath={album.basePath}
                                                alt={album.title}
                                                class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                                            />
                                            <span class="album-cover__open" aria-hidden="true">打开相册 <span>↗</span></span>
                                        </div>
                                        <!-- 相册信息 -->
                                        <div class="album-card-body p-4">
                                            <h3 class="font-bold text-lg text-neutral-900 dark:text-neutral-100 mb-2 group-hover:text-(--primary) transition-colors">
                                                {album.title}
                                            </h3>
                                            {album.description && (
                                                <p class="text-neutral-600 dark:text-neutral-400 text-sm mb-3 line-clamp-2">
                                                    {album.description}
                                                </p>
                                            )}
                                            <!-- 元数据 -->
                                            <div class="album-meta flex items-center justify-between text-xs text-neutral-500 dark:text-neutral-500">
                                                <div class="flex items-center gap-4">
                                                    <span>{album.photos.length} {album.photos.length > 1 ? i18n(I18nKey.albumsPhotosCount) : i18n(I18nKey.albumsPhotoCount)}</span>
                                                    {album.location && (
                                                        <span class="flex items-center gap-1">
                                                            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                                                                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                                                            </svg>
                                                            {album.location}
                                                        </span>
                                                    )}
                                                </div>
                                                <time>{new Date(album.date).toLocaleDateString(langToLocaleMap[siteConfig.lang] || "zh-Hans")}</time>
                                            </div>
                                            <!-- 标签 -->
                                            {album.tags && album.tags.length > 0 && (
                                                <div class="flex flex-wrap gap-1 mt-3">
                                                    {album.tags.slice(0, 3).map(tag => (
                                                        <span class="btn-regular h-6 text-xs px-2 rounded-lg">
                                                            {tag}
                                                        </span>
                                                    ))}
                                                    {album.tags.length > 3 && (
                                                        <span class="btn-regular h-6 text-xs px-2 rounded-lg">
                                                            +{album.tags.length - 3}
                                                        </span>
                                                    )}
                                                </div>
                                            )}
                                        </div>
                                    </a>
                                </article>
                            ))}
                        </div>
                    </section>
                ))}
            </div>

            <!-- 空状态 -->
            {visibleAlbums.length === 0 && (
                <div class="text-center py-12">
                    <div class="text-neutral-400 dark:text-neutral-600 mb-4">
                        <svg class="w-16 h-16 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                    </div>
                    <h3 class="text-lg font-medium text-neutral-900 dark:text-neutral-100 mb-2">
                        {i18n(I18nKey.albumsEmpty)}
                    </h3>
                    <p class="text-neutral-600 dark:text-neutral-400">
                        {i18n(I18nKey.albumsEmptyDesc)}
                    </p>
                </div>
            )}
        </div>
    </div>
</GridLayout>

<style>
    .album-hero {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        border: 1px solid color-mix(in srgb, var(--primary) 18%, var(--line-divider));
        background: linear-gradient(135deg, color-mix(in srgb, var(--primary) 11%, var(--card-bg)), color-mix(in srgb, var(--card-bg) 88%, transparent));
        box-shadow: 0 1.25rem 3rem color-mix(in srgb, var(--primary) 9%, transparent);
    }
    .album-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        color: var(--primary);
        font-size: .68rem;
        font-weight: 800;
        letter-spacing: .16em;
    }
    .album-eyebrow::before {
        content: "";
        width: 1.75rem;
        height: 2px;
        border-radius: 99px;
        background: var(--primary);
    }
    .album-hero__glow {
        position: absolute;
        z-index: -1;
        width: 16rem;
        height: 16rem;
        border-radius: 999px;
        filter: blur(3px);
        opacity: .25;
        pointer-events: none;
        background: radial-gradient(circle, var(--primary), transparent 68%);
    }
    .album-hero__glow--one { top: -9rem; right: 8%; }
    .album-hero__glow--two { bottom: -11rem; left: 18%; opacity: .12; }
    .album-hero__stats > div {
        display: grid;
        gap: .15rem;
        min-width: 0;
        padding: .75rem .85rem;
        border: 1px solid color-mix(in srgb, var(--primary) 15%, var(--line-divider));
        border-radius: .9rem;
        background: color-mix(in srgb, var(--card-bg) 72%, transparent);
    }
    .album-hero__stats strong { color: var(--primary); font-size: 1.25rem; line-height: 1; }
    .album-hero__stats span { color: var(--text-secondary); font-size: .68rem; }
    .album-section-heading__mark {
        width: .55rem;
        height: 1.8rem;
        border-radius: 99px;
        background: linear-gradient(180deg, var(--primary), color-mix(in srgb, var(--primary) 30%, transparent));
        box-shadow: 0 .25rem .8rem color-mix(in srgb, var(--primary) 25%, transparent);
    }
    .album-section-heading > span:last-child {
        background: color-mix(in srgb, var(--primary) 10%, transparent);
    }
    .album-card:hover {
        translate: 0 -4px;
        border-color: color-mix(in srgb, var(--primary) 42%, var(--line-divider));
        box-shadow: 0 1rem 2.4rem color-mix(in srgb, var(--primary) 12%, transparent);
    }
    .album-card {
        border: 1px solid color-mix(in srgb, var(--line-divider) 82%, var(--primary));
        background: color-mix(in srgb, var(--card-bg) 96%, transparent);
    }
    .album-cover {
        position: relative;
        isolation: isolate;
        background: linear-gradient(135deg, color-mix(in srgb, var(--primary) 12%, var(--btn-regular-bg)), var(--btn-regular-bg));
    }
    .album-cover::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        background: linear-gradient(180deg, transparent 45%, rgb(5 8 18 / 28%));
        opacity: .45;
        transition: opacity .25s ease;
    }
    .album-cover::before {
        content: "";
        position: absolute;
        inset: .65rem;
        z-index: 2;
        border: 1px solid rgba(255, 255, 255, .34);
        border-radius: .85rem;
        opacity: .55;
        pointer-events: none;
        transition: inset .3s ease, opacity .3s ease;
    }
    .album-card:hover .album-cover::after { opacity: .75; }
    .album-card:hover .album-cover::before { inset: .5rem; opacity: .9; }
    .album-cover__open {
        position: absolute;
        right: 1.2rem;
        bottom: 1rem;
        z-index: 3;
        padding: .35rem .65rem;
        border: 1px solid rgba(255, 255, 255, .25);
        border-radius: 999px;
        color: white;
        background: rgba(12, 22, 48, .48);
        font-size: .68rem;
        font-weight: 700;
        opacity: 0;
        transform: translateY(.35rem);
        backdrop-filter: blur(10px);
        transition: opacity .25s ease, transform .25s ease;
    }
    .album-card:hover .album-cover__open { opacity: 1; transform: translateY(0); }
    .album-cover :global(img) {
        object-position: center;
        transition: transform .45s cubic-bezier(.2,.7,.2,1), filter .45s ease;
    }
    .album-card:hover .album-cover :global(img) {
        transform: scale(1.06);
        filter: saturate(1.08) contrast(1.03);
    }
    .album-card-body { background: linear-gradient(180deg, color-mix(in srgb, var(--card-bg) 96%, transparent), var(--card-bg)); }
    .album-card h3 { letter-spacing: -.02em; }
    .album-card p { line-height: 1.55; }
    .album-meta { border-top: 1px solid color-mix(in srgb, var(--line-divider) 75%, transparent); padding-top: .7rem; }
    .album-card .btn-regular { border: 1px solid color-mix(in srgb, var(--primary) 15%, transparent); background: color-mix(in srgb, var(--primary) 7%, var(--btn-regular-bg)); color: var(--text-secondary); }
    .album-card .btn-regular:hover { color: var(--primary); border-color: color-mix(in srgb, var(--primary) 35%, transparent); }
    @media (prefers-reduced-motion: reduce) {
        .album-card, .album-cover :global(img) { transition: none; }
    }
    @keyframes fadeInUp {
        from {
            opacity: 0;
            translate: 0 20px;
        }
        to {
            opacity: 1;
            translate: 0 0;
        }
    }
    .album-card {
        animation: fadeInUp 0.3s ease-out;
    }
</style>

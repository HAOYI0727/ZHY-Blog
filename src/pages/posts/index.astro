---
// src/pages/posts/index.astro
import { LinkPresets } from "@constants/link-presets";
import { LinkPreset } from "@/types/config";
import { getSortedPostsList, getTagsGroupedByCategory } from "@utils/post";
import { getCategoryPathParts } from "@utils/category";
import { getCategoryUrl, getTagUrl } from "@utils/url";
import GridLayout from "@layouts/grid.astro";
import ContinueReading from "@components/ContinueReading.astro";
import { siteConfig } from "@/config";
import { langToLocaleMap } from "@i18n/language";
import { i18n } from "@i18n/translation";
import I18nKey from "@i18n/i18nKey";

const pageTitle = LinkPresets[LinkPreset.Posts].name;
const pageDescription = LinkPresets[LinkPreset.Posts].description;

const allPosts = await getSortedPostsList();
const topicGroups = (await getTagsGroupedByCategory()).map((group) => ({
  ...group,
  count: allPosts.filter((post) => getCategoryPathParts(post.data.category)?.[0] === group.category).length,
}));

// 按年月分组，记录最早文章的封面
type MonthGroup = {
  year: number;
  month: number;
  count: number;
  earliestCover: string | null; // 最早文章的封面
  earliestDate: Date | null;    // 辅助比较
};
const monthMap = new Map<string, MonthGroup>();

for (const post of allPosts) {
  const date = post.data.published;
  if (!date) continue;
  const year = date.getFullYear();
  const month = date.getMonth() + 1;
  const key = `${year}-${String(month).padStart(2, "0")}`;
  if (!monthMap.has(key)) {
    monthMap.set(key, {
      year,
      month,
      count: 0,
      earliestCover: null,
      earliestDate: null,
    });
  }
  const group = monthMap.get(key)!;
  group.count += 1;
  // 如果该月还没有记录日期，或当前日期更早，则更新为最早文章的封面
  if (!group.earliestDate || date < group.earliestDate) {
    group.earliestDate = date;
    // 只保存有效的封面
    const cover = post.data.cover;
    if (cover && typeof cover === 'string' && cover.trim() !== '') {
      group.earliestCover = cover;
    } else {
      group.earliestCover = null;
    }
  }
}

// 按年份降序，月份降序排列（最新在前）
const monthGroups = Array.from(monthMap.values()).sort((a, b) => {
  if (a.year !== b.year) return b.year - a.year;
  return b.month - a.month;
});

const dateLocale = langToLocaleMap[siteConfig.lang] || "zh-Hans";
const yearMonthFormatter = new Intl.DateTimeFormat(dateLocale, { year: "numeric", month: "long" });
---

<GridLayout title={pageTitle} description={pageDescription}>
  <ContinueReading />
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-9 py-6 relative w-full">
      
      <!-- 标题区 -->
      <header class="mb-7 flex flex-wrap items-start justify-between gap-4">
        <div>
          <h1 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100 mb-2">
            {pageTitle}
          </h1>
          {pageDescription && (
            <p class="text-neutral-600 dark:text-neutral-400">
              {pageDescription}
            </p>
          )}
        </div>
        <span class="inline-flex items-center gap-1 px-3 py-1 bg-(--primary)/10 text-(--primary) text-sm rounded-full font-medium">
          <span class="i-ic:round-article w-4 h-4"></span>
          {allPosts.length} {i18n(I18nKey.postsCount)}
        </span>
      </header>

      <div class="post-browse-switch mb-8" role="tablist" aria-label="文章浏览方式">
        <button type="button" role="tab" aria-selected="true" aria-controls="post-view-month" data-post-view-button="month">
          <span class="i-material-symbols:calendar-month-outline-rounded text-lg"></span>
          按年月
        </button>
        <button type="button" role="tab" aria-selected="false" aria-controls="post-view-topic" data-post-view-button="topic">
          <span class="i-material-symbols:category-outline-rounded text-lg"></span>
          按分类标签
        </button>
      </div>

      <!-- 月份卡片网格：每行3个，1:1方形 -->
      <section id="post-view-month" data-post-view="month" role="tabpanel" aria-label="按年月浏览文章">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {monthGroups.map(({ year, month, count, earliestCover }) => {
          // 构建月份链接
          const monthLink = `/posts/${year}/${String(month).padStart(2, "0")}/`;
          // 如果没有封面，生成渐变色背景
          const hue = (year * 31 + month * 7) % 360;
          const bgGradient = `linear-gradient(135deg, hsl(${hue}, 70%, 60%), hsl(${(hue + 40) % 360}, 70%, 50%))`;
          
          return (
            <a
              href={monthLink}
              class="group relative block rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-400 hover:-translate-y-2 bg-white dark:bg-gray-800"
              style="aspect-ratio: 1/1;"
            >
              <!-- 背景图片或渐变 -->
              <div class="absolute inset-0 overflow-hidden">
                {earliestCover ? (
                  <img
                    src={earliestCover}
                    alt=""
                    class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    loading="lazy"
                    decoding="async"
                    onerror="this.style.display='none'"
                  />
                ) : (
                  // 无封面：渐变背景 + 装饰
                  <div class="absolute inset-0" style={`background: ${bgGradient};`}>
                    <div class="absolute inset-0 opacity-30 bg-[radial-gradient(circle_at_30%_30%,white,transparent)]"></div>
                    <div class="absolute bottom-0 right-0 w-32 h-32 rounded-full bg-white/10 blur-2xl"></div>
                  </div>
                )}
                {/* 深色渐变遮罩，确保底部文字可读 */}
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
              </div>

              {/* 底部信息区域 */}
              <div class="absolute bottom-0 left-0 right-0 p-5 text-white z-10">
                <div class="text-xl font-bold drop-shadow-lg leading-tight">
                  {yearMonthFormatter.format(new Date(year, month - 1, 1))}
                </div>
                <div class="flex items-center gap-2 text-sm opacity-90 drop-shadow-md mt-1">
                  <span class="i-ic:round-article w-4 h-4"></span>
                  <span>{count} {i18n(I18nKey.postsCount)}</span>
                  {earliestCover && (
                    <span class="text-xs opacity-70 ml-1">· {i18n(I18nKey.coverImage)}</span>
                  )}
                </div>
              </div>

              {/* 悬停光晕效果 */}
              <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none">
                <div class="absolute inset-0 bg-gradient-to-tr from-white/10 to-transparent"></div>
              </div>
            </a>
          );
        })}
      </div>

      <!-- 底部统计 -->
      <div class="mt-12 text-center text-60 text-sm">
        {monthGroups.length} {i18n(I18nKey.monthArchives)}
      </div>
      </section>

      <section id="post-view-topic" data-post-view="topic" role="tabpanel" aria-label="按分类标签浏览文章" hidden>
        <div class="topic-browser-grid">
          {topicGroups.map((group, index) => (
            <article class="topic-browser-card" style={`--topic-order:${index}`}>
              <a class="topic-browser-head" href={getCategoryUrl(group.category)}>
                <span class="topic-browser-icon">
                  <span class="i-material-symbols:folder-open-outline-rounded"></span>
                </span>
                <span class="min-w-0">
                  <strong>{group.category.replaceAll("_", " ")}</strong>
                  <small>{group.count} 篇文章 · {group.tags.length} 个标签</small>
                </span>
                <span class="i-material-symbols:arrow-outward-rounded topic-browser-arrow"></span>
              </a>
              <nav class="topic-tag-list" aria-label={`${group.category} 标签`}>
                {group.tags.map((tag) => (
                  <a href={getTagUrl(tag)}>#{tag}</a>
                ))}
              </nav>
            </article>
          ))}
        </div>
        <div class="mt-9 text-center text-60 text-sm">
          {topicGroups.length} 个分类 · 点击标签可直接筛选文章
        </div>
      </section>
    </div>
  </div>
</GridLayout>

<style is:global>
  /* 保证卡片是1:1正方形 */
  .aspect-\[1\/1\] {
    aspect-ratio: 1 / 1;
  }
  /* 图片加载失败时隐藏 */
  .absolute.inset-0 > img[style*="display: none"] {
    display: none !important;
  }
  /* 暗色模式下卡片背景 */
  .dark .group.bg-white {
    background-color: #1f1f1f;
  }

  .post-browse-switch {
    display: inline-flex;
    gap: 0.35rem;
    padding: 0.35rem;
    border: 1px solid var(--line-divider);
    border-radius: 0.9rem;
    background: color-mix(in srgb, var(--btn-regular-bg) 74%, transparent);
  }

  .post-browse-switch button {
    display: inline-flex;
    min-height: 2.65rem;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    border: 0;
    border-radius: 0.65rem;
    background: transparent;
    padding: 0.5rem 0.9rem;
    color: var(--text-secondary);
    font-size: 0.86rem;
    font-weight: 650;
    cursor: pointer;
    transition: color 160ms ease, background-color 160ms ease, box-shadow 160ms ease;
  }

  .post-browse-switch button[aria-selected="true"] {
    background: var(--card-bg);
    color: var(--primary);
    box-shadow: 0 0.25rem 0.9rem rgb(0 0 0 / 9%);
  }

  .topic-browser-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .topic-browser-card {
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--primary) 18%, var(--line-divider));
    border-radius: 1.15rem;
    background:
      radial-gradient(circle at 100% 0%, color-mix(in oklch, var(--primary) 13%, transparent), transparent 42%),
      color-mix(in srgb, var(--card-bg) 86%, transparent);
    padding: 1rem;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 8%);
  }

  .topic-browser-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-color);
  }

  .topic-browser-icon {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border-radius: 0.85rem;
    background: color-mix(in oklch, var(--primary) 16%, var(--btn-regular-bg));
    color: var(--primary);
    font-size: 1.35rem;
  }

  .topic-browser-head strong { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 1rem; }
  .topic-browser-head small { display: block; margin-top: 0.15rem; color: var(--text-secondary); font-size: 0.72rem; }
  .topic-browser-arrow { color: var(--primary); transition: transform 160ms ease; }
  .topic-browser-head:hover .topic-browser-arrow { transform: rotate(45deg); }

  .topic-tag-list { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 0.9rem; }
  .topic-tag-list a {
    border: 1px solid color-mix(in srgb, var(--primary) 16%, transparent);
    border-radius: 999px;
    background: var(--btn-regular-bg);
    padding: 0.28rem 0.62rem;
    color: var(--text-secondary);
    font-size: 0.7rem;
    line-height: 1.25;
    transition: color 150ms ease, border-color 150ms ease, background-color 150ms ease, transform 150ms ease;
  }
  .topic-tag-list a:hover {
    border-color: var(--primary);
    background: color-mix(in oklch, var(--primary) 15%, var(--btn-regular-bg));
    color: var(--text-color);
    transform: translateY(-1px);
  }

  @media (max-width: 700px) {
    .post-browse-switch { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); width: 100%; }
    .topic-browser-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  const setupPostBrowseSwitcher = () => {
    const root = document.querySelector<HTMLElement>("#swup-container");
    if (!root || root.dataset.postBrowseReady === "true") return;
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-post-view-button]"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-post-view]"));
    if (buttons.length === 0 || panels.length === 0) return;
    root.dataset.postBrowseReady = "true";

    const selectView = (view: string) => {
      buttons.forEach((button) => button.setAttribute("aria-selected", String(button.dataset.postViewButton === view)));
      panels.forEach((panel) => { panel.hidden = panel.dataset.postView !== view; });
    };

    buttons.forEach((button) => button.addEventListener("click", () => selectView(button.dataset.postViewButton || "month")));
    selectView("month");
  };

  setupPostBrowseSwitcher();
  document.addEventListener("astro:page-load", setupPostBrowseSwitcher);
</script>

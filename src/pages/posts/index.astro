---
import { LinkPresets } from "@constants/link-presets";
import { LinkPreset } from "@/types/config";
import { getSortedPostsList } from "@utils/post";
import { getCategoryPathParts } from "@utils/category";
import { getCategoryUrl, getPostUrl, getTagUrl } from "@utils/url";
import { parseTags } from "@utils/tag";
import GridLayout from "@layouts/grid.astro";
import ContinueReading from "@components/ContinueReading.astro";
import { i18n } from "@i18n/translation";
import I18nKey from "@i18n/i18nKey";

const pageTitle = LinkPresets[LinkPreset.Posts].name;
const pageDescription = LinkPresets[LinkPreset.Posts].description;
const allPosts = await getSortedPostsList();

type TopicGroup = {
  category: string;
  posts: typeof allPosts;
  tags: string[];
  cover: string | null;
};

const topicMap = new Map<string, TopicGroup>();
for (const post of allPosts) {
  const category = getCategoryPathParts(post.data.category)?.[0] || "未分类";
  const group = topicMap.get(category) || { category, posts: [], tags: [], cover: null };
  group.posts.push(post);
  group.tags = Array.from(new Set([...group.tags, ...parseTags(post.data.tags)])).sort((a, b) => a.localeCompare(b));
  topicMap.set(category, group);
}

const topicGroups = Array.from(topicMap.values())
  .map((group) => {
    group.posts.sort((a, b) => new Date(b.data.published).getTime() - new Date(a.data.published).getTime());
    const earliest = group.posts[group.posts.length - 1];
    group.cover = typeof earliest?.data.cover === "string" && earliest.data.cover.trim() ? earliest.data.cover : null;
    return group;
  })
  .sort((a, b) => b.posts.length - a.posts.length || a.category.localeCompare(b.category));

const heatCandidates = allPosts.slice().sort((a, b) => new Date(b.data.published).getTime() - new Date(a.data.published).getTime());
const heatCardGradient = (index: number) => `linear-gradient(135deg, oklch(0.68 0.16 ${205 + index * 17}), oklch(0.45 0.16 ${255 + index * 13}))`;

type MonthGroup = { key: string; year: number; month: number; posts: typeof allPosts };
const monthMap = new Map<string, MonthGroup>();
for (const post of allPosts) {
  const date = new Date(post.data.published);
  const key = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}`;
  const group = monthMap.get(key) || { key, year: date.getFullYear(), month: date.getMonth() + 1, posts: [] };
  group.posts.push(post);
  monthMap.set(key, group);
}
const monthGroups = Array.from(monthMap.values()).sort((a, b) => b.key.localeCompare(a.key));
---

<GridLayout title={pageTitle} description={pageDescription}>
  <ContinueReading />
  <div class="posts-shell">
    <div class="card-base posts-panel">
      <header class="posts-header">
        <div>
          <p class="posts-eyebrow"><span class="posts-eyebrow-dot"></span> KNOWLEDGE LIBRARY</p>
          <h1>{pageTitle}</h1>
          {pageDescription && <p class="posts-description">{pageDescription}</p>}
        </div>
        <div class="posts-count"><strong>{allPosts.length}</strong><span>{i18n(I18nKey.postsCount)}</span></div>
      </header>

      <div class="post-browse-switch" role="tablist" aria-label="文章浏览方式">
        <button type="button" role="tab" aria-selected="true" aria-controls="post-view-topic" data-post-view-button="topic"><span class="i-material-symbols:category-outline-rounded"></span>按主题</button>
        <button type="button" role="tab" aria-selected="false" aria-controls="post-view-heat" data-post-view-button="heat"><span class="i-material-symbols:local-fire-department-outline-rounded"></span>按热度</button>
        <button type="button" role="tab" aria-selected="false" aria-controls="post-view-month" data-post-view-button="month"><span class="i-material-symbols:calendar-month-outline-rounded"></span>按年月</button>
      </div>

      <section id="post-view-month" data-post-view="month" role="tabpanel" aria-label="按年月浏览文章" hidden>
        <div class="month-browser-list">
          {monthGroups.map((group) => (
            <article class="month-browser-card">
              <header class="month-browser-header">
                <div><span class="month-browser-number">{String(group.month).padStart(2, "0")}</span><h2>{group.year}年{group.month}月</h2></div>
                <span>{group.posts.length} 篇</span>
              </header>
              <div class="month-browser-posts">
                {group.posts.map((post) => <a href={getPostUrl(post)}><time datetime={new Date(post.data.published).toISOString()}>{new Date(post.data.published).toLocaleDateString("zh-CN", { month: "2-digit", day: "2-digit" })}</time><span>{post.data.title}</span><span class="i-material-symbols:arrow-outward-rounded"></span></a>)}
              </div>
            </article>
          ))}
        </div>
        <p class="posts-footnote">按发布时间倒序排列</p>
      </section>

      <section id="post-view-topic" data-post-view="topic" role="tabpanel" aria-label="按主题浏览文章">
        <div class="topic-browser-grid">
          {topicGroups.map((group, index) => {
            return (
              <article class="topic-browser-card">
                <a class="topic-browser-cover" href={getCategoryUrl(group.category)} aria-label={`查看${group.category.replaceAll("_", " ")}主题`}>
                  {group.cover ? <img src={group.cover} alt="" loading="lazy" decoding="async" /> : <div class="topic-browser-cover-fallback" style={`background:${heatCardGradient(index)}`}></div>}
                  <div class="topic-browser-cover-shade"></div>
                  <span class="topic-browser-index">{String(index + 1).padStart(2, "0")}</span><span class="topic-browser-count">{group.posts.length} 篇</span>
                </a>
                <div class="topic-browser-content">
                  <a class="topic-browser-head" href={getCategoryUrl(group.category)}>
                    <span class="min-w-0"><strong>{group.category.replaceAll("_", " ")}</strong><small>{group.tags.length} 个知识标签</small></span>
                    <span class="i-material-symbols:arrow-outward-rounded topic-browser-arrow"></span>
                  </a>
                  <div class="topic-latest">
                    <span class="topic-latest-label">最近更新</span>
                    <div class="topic-latest-list">{group.posts.slice(0, 3).map((post) => <a href={getPostUrl(post)}>{post.data.title}</a>)}</div>
                  </div>
                  <nav class="topic-tag-list" aria-label={`${group.category} 标签`}>{group.tags.slice(0, 8).map((tag) => <a href={getTagUrl(tag)}>#{tag}</a>)}</nav>
                </div>
              </article>
            );
          })}
        </div>
        <p class="posts-footnote">{topicGroups.length} 个主题 · 主题内按发布时间排序</p>
      </section>

      <section id="post-view-heat" data-post-view="heat" role="tabpanel" aria-label="按热度浏览文章" hidden>
        <div class="heat-intro"><div><p class="posts-eyebrow"><span class="posts-eyebrow-dot fire"></span> CURRENT SIGNAL</p><h2>最受关注的文章</h2></div><span class="heat-update-note">热度 = 浏览量 + 点赞 × 6</span></div>
        <div class="heat-list" data-heat-list>
          {heatCandidates.map((post, index) => {
            const postDate = new Date(post.data.published);
            const category = getCategoryPathParts(post.data.category)?.[0] || "未分类";
            return (
              <article class="heat-card" data-heat-card data-post-id={post.id} data-published={postDate.getTime()} data-heat="0" data-default-order={index}>
                <div class="heat-rank" data-heat-rank>{String(index + 1).padStart(2, "0")}</div>
                <a href={getPostUrl(post)} class="heat-cover" aria-label={post.data.title}>{post.data.cover ? <img src={post.data.cover} alt="" loading="lazy" decoding="async" /> : <span style={`background:${heatCardGradient(index)}`}></span>}</a>
                <div class="heat-body"><div class="heat-meta"><span>{category.replaceAll("_", " ")}</span><time datetime={postDate.toISOString()}>{postDate.toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" })}</time></div><a href={getPostUrl(post)} class="heat-title">{post.data.title}</a>{post.data.description && <p>{post.data.description}</p>}</div>
                <div class="heat-score"><span class="i-material-symbols:local-fire-department-rounded"></span><strong data-heat-value>0</strong><small>热度</small></div>
              </article>
            );
          })}
        </div>
        <nav class="heat-pagination" data-heat-pagination aria-label="热度文章分页">
          <button type="button" data-heat-prev disabled>上一页</button>
          <span data-heat-page>第 1 页</span>
          <button type="button" data-heat-next>下一页</button>
        </nav>
        <p class="posts-footnote">共 {allPosts.length} 篇 · 每页 10 篇 · 热度相同时按最新文章优先</p>
      </section>

    </div>
  </div>
</GridLayout>

<style is:global>
  .posts-shell { width: 100%; overflow: hidden; border-radius: var(--radius-large); }
  .posts-panel { position: relative; padding: 2rem clamp(1.1rem, 3vw, 2.5rem) 2.6rem; }
  .posts-header { display:flex; justify-content:space-between; align-items:flex-start; gap:1.25rem; margin-bottom:1.6rem; }
  .posts-header h1 { margin: .2rem 0 .45rem; color:var(--text-color); font-size:clamp(1.75rem, 3vw, 2.45rem); letter-spacing:-.04em; }
  .posts-description { max-width:40rem; color:var(--text-secondary); font-size:.94rem; line-height:1.6; }
  .posts-eyebrow { display:flex; align-items:center; gap:.48rem; margin:0; color:var(--text-tertiary); font-size:.68rem; font-weight:800; letter-spacing:.16em; }
  .posts-eyebrow-dot { width:.48rem; height:.48rem; border-radius:50%; background:var(--primary); box-shadow:0 0 0 .22rem color-mix(in srgb, var(--primary) 15%, transparent); }
  .posts-eyebrow-dot.fire { background:#f18a3d; box-shadow:0 0 0 .22rem #f18a3d22; }
  .posts-count { display:flex; align-items:baseline; gap:.38rem; padding:.7rem .95rem; border:1px solid color-mix(in srgb, var(--primary) 20%, var(--line-divider)); border-radius:1rem; background:color-mix(in srgb, var(--primary) 8%, var(--card-bg)); color:var(--text-secondary); white-space:nowrap; }
  .posts-count strong { color:var(--primary); font-size:1.55rem; line-height:1; }
  .posts-count span { font-size:.78rem; }
  .post-browse-switch { display:flex; width:min(100%, 34rem); margin:0 auto 1.7rem; padding:.3rem; gap:.3rem; border:1px solid color-mix(in srgb, var(--primary) 18%, var(--line-divider)); border-radius:1rem; background:linear-gradient(135deg, color-mix(in srgb, var(--primary) 8%, var(--btn-regular-bg)), color-mix(in srgb, var(--btn-regular-bg) 88%, transparent)); box-shadow:inset 0 1px 0 rgb(255 255 255 / 10%), 0 .45rem 1.2rem rgb(0 0 0 / 5%); }
  .post-browse-switch button { position:relative; display:flex; flex:1 1 0; min-height:2.75rem; align-items:center; justify-content:center; gap:.5rem; overflow:hidden; border:1px solid transparent; border-radius:.72rem; background:transparent; color:var(--text-tertiary); font-size:.86rem; font-weight:750; letter-spacing:.01em; cursor:pointer; transition:color 180ms ease, background 180ms ease, border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease; }
  .post-browse-switch button::before { content:""; position:absolute; inset:0; background:linear-gradient(110deg, transparent 20%, rgb(255 255 255 / 18%), transparent 80%); transform:translateX(-120%); transition:transform 420ms ease; pointer-events:none; }
  .post-browse-switch button:hover { color:var(--text-color); background:color-mix(in srgb, var(--card-bg) 56%, transparent); }
  .post-browse-switch button:hover::before { transform:translateX(120%); }
  .post-browse-switch button:focus-visible { outline:2px solid var(--primary); outline-offset:2px; }
  .post-browse-switch button:active { transform:scale(.985); }
  .post-browse-switch button span { position:relative; z-index:1; display:grid; width:1.45rem; height:1.45rem; place-items:center; border-radius:.45rem; background:color-mix(in srgb, currentColor 10%, transparent); font-size:1.05rem; transition:background 180ms ease, transform 180ms ease; }
  .post-browse-switch button[aria-selected="true"] { border-color:color-mix(in srgb, var(--primary) 28%, transparent); background:linear-gradient(135deg, color-mix(in srgb, var(--primary) 17%, var(--card-bg)), var(--card-bg)); color:var(--primary); box-shadow:0 .35rem 1rem color-mix(in srgb, var(--primary) 16%, transparent), inset 0 1px 0 rgb(255 255 255 / 16%); }
  .post-browse-switch button[aria-selected="true"] span { background:color-mix(in srgb, var(--primary) 15%, transparent); transform:scale(1.06); }
  .month-browser-list { display:grid; gap:1rem; }
  .month-browser-card { overflow:hidden; border:1px solid var(--line-divider); border-radius:1.05rem; background:color-mix(in srgb, var(--card-bg) 88%, transparent); }
  .month-browser-header { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:.85rem 1rem .75rem; border-bottom:1px solid var(--line-divider); background:linear-gradient(90deg, color-mix(in srgb, var(--primary) 9%, transparent), transparent 55%); }
  .month-browser-header > div { display:flex; align-items:center; gap:.65rem; }
  .month-browser-number { display:grid; width:2rem; height:2rem; place-items:center; border-radius:.65rem; background:color-mix(in srgb, var(--primary) 13%, var(--btn-regular-bg)); color:var(--primary); font-size:.72rem; font-weight:800; }
  .month-browser-header h2 { margin:0; color:var(--text-color); font-size:1.05rem; }
  .month-browser-header > span { color:var(--text-tertiary); font-size:.72rem; }
  .month-browser-posts { padding:.3rem .7rem .5rem; }
  .month-browser-posts a { display:grid; grid-template-columns:3.3rem minmax(0,1fr) auto; align-items:center; gap:.7rem; min-height:2.55rem; border-radius:.65rem; color:var(--text-secondary); transition:background 150ms ease, color 150ms ease, transform 150ms ease; }
  .month-browser-posts a:hover { background:color-mix(in srgb, var(--primary) 8%, transparent); color:var(--text-color); transform:translateX(3px); }
  .month-browser-posts time { color:var(--text-tertiary); font-size:.72rem; font-variant-numeric:tabular-nums; text-align:right; }
  .month-browser-posts a > span:nth-child(2) { overflow:hidden; font-size:.86rem; font-weight:650; text-overflow:ellipsis; white-space:nowrap; }
  .month-browser-posts a > span:last-child { color:var(--text-tertiary); font-size:1rem; }
  .topic-browser-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1.1rem; }
  .topic-browser-card { overflow:hidden; border:1px solid color-mix(in srgb, var(--primary) 18%, var(--line-divider)); border-radius:1.2rem; background:color-mix(in srgb, var(--card-bg) 92%, transparent); box-shadow:inset 0 1px 0 rgb(255 255 255 / 8%); }
  .topic-browser-cover { position:relative; aspect-ratio:1; overflow:hidden; background:var(--btn-regular-bg); }
  .topic-browser-cover img, .topic-browser-cover-fallback { width:100%; height:100%; object-fit:cover; }
  .topic-browser-cover { display:block; }
  .topic-browser-cover-shade { position:absolute; inset:0; background:linear-gradient(180deg,transparent 20%,rgb(8 12 22 / 70%)); }
  .topic-browser-index, .topic-browser-count { position:absolute; bottom:.75rem; color:white; font-size:.72rem; font-weight:750; letter-spacing:.08em; text-shadow:0 1px 4px #000; }
  .topic-browser-index { left:1rem; font-size:1.2rem; }
  .topic-browser-count { right:1rem; }
  .topic-browser-content { padding:1rem 1.05rem 1.05rem; }
  .topic-browser-head { display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:.7rem; color:var(--text-color); }
  .topic-browser-head strong { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:1.05rem; }
  .topic-browser-head small { display:block; margin-top:.18rem; color:var(--text-tertiary); font-size:.72rem; }
  .topic-browser-arrow { color:var(--primary); transition:transform 160ms ease; }
  .topic-browser-head:hover .topic-browser-arrow { transform:rotate(45deg); }
  .topic-latest { margin-top:.85rem; padding-top:.72rem; border-top:1px solid var(--line-divider); }
  .topic-latest-label { display:block; margin-bottom:.3rem; color:var(--text-tertiary); font-size:.68rem; letter-spacing:.06em; }
  .topic-latest-list { display:grid; gap:.35rem; }
  .topic-latest-list a { position:relative; display:block; overflow:hidden; padding-left:.75rem; color:var(--text-secondary); font-size:.8rem; line-height:1.4; text-overflow:ellipsis; white-space:nowrap; }
  .topic-latest-list a::before { content:""; position:absolute; top:.5rem; left:.05rem; width:.28rem; height:.28rem; border-radius:50%; background:color-mix(in srgb, var(--primary) 65%, var(--line-divider)); }
  .topic-latest-list a:hover { color:var(--primary); }
  .topic-tag-list { display:flex; flex-wrap:wrap; gap:.4rem; margin-top:.78rem; }
  .topic-tag-list a { border:1px solid color-mix(in srgb, var(--primary) 16%, transparent); border-radius:999px; background:var(--btn-regular-bg); padding:.25rem .55rem; color:var(--text-tertiary); font-size:.68rem; line-height:1.2; }
  .topic-tag-list a:hover { border-color:var(--primary); background:color-mix(in srgb, var(--primary) 12%, var(--btn-regular-bg)); color:var(--text-color); }
  .posts-footnote { margin:1.4rem 0 0; color:var(--text-tertiary); text-align:center; font-size:.78rem; }
  .heat-intro { display:flex; justify-content:space-between; align-items:end; gap:1rem; margin-bottom:1rem; }
  .heat-intro h2 { margin:.28rem 0 0; color:var(--text-color); font-size:1.4rem; letter-spacing:-.03em; }
  .heat-update-note { color:var(--text-tertiary); font-size:.72rem; }
  .heat-list { display:grid; gap:.8rem; }
  .heat-card { display:grid; grid-template-columns:3rem 6.3rem minmax(0,1fr) 5rem; align-items:center; gap:1rem; min-height:7.7rem; padding:.85rem 1rem .85rem .65rem; border:1px solid var(--line-divider); border-radius:1.1rem; background:color-mix(in srgb, var(--card-bg) 88%, transparent); transition:transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease; }
  .heat-card:hover { transform:translateY(-2px); border-color:color-mix(in srgb, var(--primary) 45%, var(--line-divider)); box-shadow:0 .7rem 1.6rem rgb(0 0 0 / 8%); }
  .heat-card[data-heat-rank="1"] { border-color:#f3a54c88; background:linear-gradient(90deg,#f3a54c12,transparent 35%), color-mix(in srgb, var(--card-bg) 88%, transparent); }
  .heat-rank { color:var(--text-tertiary); font-size:1.25rem; font-weight:850; text-align:center; font-variant-numeric:tabular-nums; }
  .heat-card[data-heat-rank="1"] .heat-rank { color:#e6902f; font-size:1.6rem; }
  .heat-cover { display:block; height:6rem; overflow:hidden; border-radius:.82rem; background:var(--btn-regular-bg); }
  .heat-cover img, .heat-cover span { display:block; width:100%; height:100%; object-fit:cover; transition:transform 300ms ease; }
  .heat-card:hover .heat-cover img { transform:scale(1.06); }
  .heat-body { min-width:0; }
  .heat-meta { display:flex; gap:.55rem; color:var(--text-tertiary); font-size:.7rem; }
  .heat-meta span { color:var(--primary); font-weight:750; }
  .heat-title { display:block; overflow:hidden; margin-top:.35rem; color:var(--text-color); font-size:1.08rem; font-weight:750; line-height:1.4; text-overflow:ellipsis; white-space:nowrap; }
  .heat-title:hover { color:var(--primary); }
  .heat-body p { display:-webkit-box; overflow:hidden; margin:.38rem 0 0; color:var(--text-tertiary); font-size:.78rem; line-height:1.45; -webkit-box-orient:vertical; -webkit-line-clamp:2; }
  .heat-score { display:flex; flex-direction:column; align-items:center; justify-content:center; color:#ef8b3a; }
  .heat-score > span { font-size:1.5rem; }
  .heat-score strong { color:var(--text-color); font-size:1.28rem; line-height:1.15; font-variant-numeric:tabular-nums; }
  .heat-score small { color:var(--text-tertiary); font-size:.65rem; }
  .heat-pagination { display:flex; align-items:center; justify-content:center; gap:.8rem; margin-top:1.2rem; }
  .heat-pagination button { min-width:4.5rem; border:1px solid var(--line-divider); border-radius:.55rem; background:var(--btn-regular-bg); color:var(--text-secondary); padding:.4rem .65rem; font-size:.76rem; cursor:pointer; }
  .heat-pagination button:hover:not(:disabled) { border-color:var(--primary); color:var(--primary); }
  .heat-pagination button:disabled { cursor:not-allowed; opacity:.4; }
  .heat-pagination span { min-width:4rem; color:var(--text-tertiary); text-align:center; font-size:.76rem; }
  @media (max-width: 1040px) { .topic-browser-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media (max-width: 700px) { .topic-browser-grid { grid-template-columns:1fr; } }
  @media (max-width: 620px) { .posts-header { flex-direction:column; } .posts-count { align-self:flex-start; } .post-browse-switch { width:100%; margin-bottom:1.35rem; } .post-browse-switch button { min-height:2.6rem; font-size:.78rem; } .post-browse-switch button span { width:1.3rem; height:1.3rem; font-size:.95rem; } .heat-card { grid-template-columns:2.1rem 4.3rem minmax(0,1fr) 3.2rem; gap:.5rem; } .heat-body p { display:none; } }
</style>

<script>
  const setupPostBrowseSwitcher = () => {
    const root = document.querySelector<HTMLElement>("#swup-container");
    const switcher = root?.querySelector<HTMLElement>(".post-browse-switch");
    if (!root || !switcher || switcher.dataset.postBrowseReady === "true") return;
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-post-view-button]"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-post-view]"));
    if (!buttons.length || !panels.length) return;
    // 标记当前页面的切换器，而不是可被 Swup 复用的外层容器。
    switcher.dataset.postBrowseReady = "true";
    const selectView = (view: string) => { buttons.forEach((button) => button.setAttribute("aria-selected", String(button.dataset.postViewButton === view))); panels.forEach((panel) => { panel.hidden = panel.dataset.postView !== view; }); };
    buttons.forEach((button) => button.addEventListener("click", () => selectView(button.dataset.postViewButton || "topic")));
    selectView("topic");
    const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-heat-card]"));
    const list = root.querySelector<HTMLElement>("[data-heat-list]");
    if (!cards.length || !list) return;
    const pageSize = 10;
    let currentPage = 1;
    const previousButton = root.querySelector<HTMLButtonElement>("[data-heat-prev]");
    const nextButton = root.querySelector<HTMLButtonElement>("[data-heat-next]");
    const pageLabel = root.querySelector<HTMLElement>("[data-heat-page]");
    const renderPage = () => {
      const pageCount = Math.max(1, Math.ceil(cards.length / pageSize));
      currentPage = Math.min(currentPage, pageCount);
      const start = (currentPage - 1) * pageSize;
      cards.forEach((card, index) => { card.hidden = index < start || index >= start + pageSize; });
      if (previousButton) previousButton.disabled = currentPage <= 1;
      if (nextButton) nextButton.disabled = currentPage >= pageCount;
      if (pageLabel) pageLabel.textContent = `第 ${currentPage} / ${pageCount} 页`;
    };
    previousButton?.addEventListener("click", () => { if (currentPage > 1) { currentPage -= 1; renderPage(); list.scrollIntoView({ behavior: "smooth", block: "start" }); } });
    nextButton?.addEventListener("click", () => { if (currentPage < Math.ceil(cards.length / pageSize)) { currentPage += 1; renderPage(); list.scrollIntoView({ behavior: "smooth", block: "start" }); } });
    const ids = cards.map((card) => card.dataset.postId || "").filter(Boolean);
    const renderHeat = (stats: Record<string, { heat?: number }>) => {
      cards.forEach((card) => { const stat = stats[card.dataset.postId || ""]; card.dataset.heat = String(Math.max(0, Number(stat?.heat) || 0)); const value = card.querySelector<HTMLElement>("[data-heat-value]"); if (value) value.textContent = card.dataset.heat; });
      cards.sort((a, b) => Number(b.dataset.heat) - Number(a.dataset.heat) || Number(b.dataset.published) - Number(a.dataset.published) || Number(a.dataset.defaultOrder) - Number(b.dataset.defaultOrder));
      cards.forEach((card, index) => { card.querySelector<HTMLElement>("[data-heat-rank]")!.textContent = String(index + 1).padStart(2, "0"); list.appendChild(card); });
      renderPage();
    };
    renderHeat({});
    fetch(`/api/engagement/?posts=${encodeURIComponent(ids.join(","))}`, { credentials: "same-origin" }).then((response) => response.ok ? response.json() : Promise.reject(new Error("engagement unavailable"))).then((payload) => renderHeat(payload.posts || {})).catch(() => undefined);
  };
  // Swup 可能在新容器插入前执行页面脚本；延后一帧，确保切页后的 DOM 已经可用。
  const schedulePostBrowseSwitcher = () => {
    requestAnimationFrame(() => window.setTimeout(setupPostBrowseSwitcher, 0));
  };
  schedulePostBrowseSwitcher();

  const browseWindow = window as typeof window & { __twilightPostBrowseSwitcherBound?: boolean };
  if (!browseWindow.__twilightPostBrowseSwitcherBound) {
    browseWindow.__twilightPostBrowseSwitcherBound = true;
    document.addEventListener("astro:page-load", schedulePostBrowseSwitcher);
    const bindSwupHook = () => {
      if (!window.swup?.hooks) return;
      window.swup.hooks.on("page:view", schedulePostBrowseSwitcher);
    };
    if (window.swup?.hooks) bindSwupHook();
    else document.addEventListener("swup:enable", bindSwupHook, { once: true });
  }
</script>

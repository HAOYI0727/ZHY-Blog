---
// src/pages/category/[...slug].astro

import GridLayout from "@layouts/grid.astro";
import BackwardButton from "@components/backwardButton.astro";
import PostCollectionGrid from "@components/PostCollectionGrid.astro";
import { i18n } from "@i18n/translation";
import I18nKey from "@i18n/i18nKey";
import { CATEGORY_SEPARATOR, getCategoryPathParts } from "@utils/category";
import { getCategoryList, getSortedPostsList } from "@utils/post";
import { getCategoryUrl } from "@utils/url";

// 生成所有分类的静态路径
export async function getStaticPaths() {
  const categories = await getCategoryList();
  const categoryPrefixes = new Map<string, number>();

  for (const category of categories) {
    const parts = category.name.split(CATEGORY_SEPARATOR).filter(Boolean);
    parts.forEach((_, index) => {
      const prefix = parts.slice(0, index + 1).join(CATEGORY_SEPARATOR);
      categoryPrefixes.set(prefix, (categoryPrefixes.get(prefix) || 0) + category.count);
    });
  }

  return Array.from(categoryPrefixes, ([name, count]) => ({
    params: { slug: name },
    props: { categoryName: name, categoryCount: count },
  }));
}

// 接收 props 和 params
const { categoryName } = Astro.props;
const slug = Astro.params.slug;
const slugParts = slug ? slug.split(CATEGORY_SEPARATOR).filter(Boolean) : [];

// 获取所有文章和分类列表
const allPosts = await getSortedPostsList();
const allCategories = await getCategoryList();

// 过滤出当前分类下的文章（精确匹配）
const filteredPosts = allPosts.filter((post) => {
  const parts = getCategoryPathParts(post.data.category);
  if (!parts) return false;
  return parts.length >= slugParts.length && slugParts.every((part, index) => parts[index] === part);
});

// 构建面包屑
const breadcrumbItems = slugParts.map((part, idx) => ({
  name: part,
  url: getCategoryUrl(slugParts.slice(0, idx + 1)),
}));

// 父级分类 URL（如果有）
const parentSlug = slugParts.length > 1 ? slugParts.slice(0, -1).join(CATEGORY_SEPARATOR) : null;
const parentUrl = parentSlug ? getCategoryUrl(parentSlug.split(CATEGORY_SEPARATOR)) : null;

// 子分类列表（直接子级）
const childCategories = allCategories.filter((cat) => {
  const parts = cat.name.split(CATEGORY_SEPARATOR).filter(Boolean);
  return (
    parts.length === slugParts.length + 1 &&
    parts.slice(0, slugParts.length).every((p, i) => p === slugParts[i])
  );
});

// 页面标题（取最后一级）
const pageTitle = slugParts[slugParts.length - 1] || categoryName;
const pageDescription = `${filteredPosts.length} ${i18n(I18nKey.postsCount)}`;
---

<GridLayout title={pageTitle} description={pageDescription}>
  <div class="category-page-shell flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="category-page-card card-base z-10 px-5 py-5 sm:px-9 sm:py-6 relative w-full">
      <BackwardButton currentPath={Astro.url.pathname} />

      <!-- 面包屑导航 -->
      <nav class="category-breadcrumb text-sm text-60 mb-5 flex flex-wrap items-center gap-1" aria-label={i18n(I18nKey.categories)}>
        <a href="/" class="hover:text-(--primary) transition-colors">{i18n(I18nKey.home)}</a>
        <span class="mx-1">/</span>
        <a href="/posts/" class="hover:text-(--primary) transition-colors">{i18n(I18nKey.categories)}</a>
        {breadcrumbItems.map((item, index) => (
          <>
            <span class="mx-1">/</span>
            {index === breadcrumbItems.length - 1 ? (
              <span class="text-90 font-medium">{item.name}</span>
            ) : (
              <a href={item.url} class="hover:text-(--primary) transition-colors">
                {item.name}
              </a>
            )}
          </>
        ))}
      </nav>

      <!-- 标题区 -->
      <header class="category-hero mb-7">
        <span class="category-kicker">KNOWLEDGE TOPIC</span>
        <h1 class="category-title">
          <span>{pageTitle}</span>
        </h1>
        <p class="category-description">
          <strong>{filteredPosts.length}</strong> {i18n(I18nKey.postsCount)} · {i18n(I18nKey.categories)}
        </p>
        <div class="mt-3 flex flex-wrap gap-3">
          <a
            href="/posts/"
            class="btn-regular h-8 px-4 rounded-lg text-sm transition-colors bg-(--primary) text-white"
          >
            {i18n(I18nKey.postsAll)}
          </a>
          {parentUrl && (
            <a
              href={parentUrl}
              class="btn-regular h-8 px-4 rounded-lg text-sm transition-colors bg-(--card-bg) hover:bg-(--primary)/10 border border-(--line-divider)"
            >
              ← {i18n(I18nKey.backToParent)}
            </a>
          )}
        </div>
      </header>

      <!-- 子分类列表（如果有） -->
      {childCategories.length > 0 && (
        <div class="mb-8">
          <h2 class="text-sm font-semibold text-60 uppercase tracking-wider mb-3">{i18n(I18nKey.subcategories)}</h2>
          <div class="flex flex-wrap gap-2">
            {childCategories.map((child) => (
              <a
                href={getCategoryUrl(child.name.split(CATEGORY_SEPARATOR))}
                class="inline-flex items-center px-4 py-2 rounded-full text-sm bg-(--card-bg) border border-(--line-divider) hover:border-(--primary) hover:text-(--primary) transition-all"
              >
                {child.name.split(CATEGORY_SEPARATOR).pop()}
                <span class="ml-1.5 text-xs opacity-60">({child.count})</span>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- 与月份归档一致的三列文章卡片视图。 -->
      <PostCollectionGrid posts={filteredPosts} emptyText={i18n(I18nKey.categoryEmpty)} />

      <!-- 回到顶部 -->
      <div class="mt-8 text-center">
        <a href="#top-row" class="text-60 text-xs hover:text-(--primary) transition-colors">
          ↑ {i18n(I18nKey.backToTop)}
        </a>
      </div>
    </div>
  </div>
</GridLayout>

<style>
  .category-page-shell {
    background:
      radial-gradient(circle at 12% 8%, color-mix(in oklch, var(--primary) 18%, transparent), transparent 22rem),
      radial-gradient(circle at 94% 92%, color-mix(in oklch, var(--primary) 10%, transparent), transparent 25rem);
  }
  .category-page-card {
    border: 1px solid color-mix(in srgb, var(--primary) 17%, var(--line-divider));
    background: linear-gradient(145deg, color-mix(in oklch, var(--primary) 5%, transparent), transparent 42%), var(--card-bg);
    box-shadow: 0 .9rem 2.6rem color-mix(in srgb, var(--primary) 7%, transparent);
  }
  .category-breadcrumb a { text-decoration: none; }
  .category-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(1.15rem, 3vw, 1.8rem);
    border: 1px solid color-mix(in oklch, var(--primary) 26%, var(--line-divider));
    border-radius: 1.1rem;
    background: linear-gradient(120deg, color-mix(in oklch, var(--primary) 13%, var(--card-bg)), color-mix(in oklch, var(--primary) 3%, var(--card-bg)) 62%, var(--card-bg));
    box-shadow: inset 0 1px 0 color-mix(in srgb, white 18%, transparent), 0 .7rem 1.8rem color-mix(in srgb, var(--primary) 8%, transparent);
  }
  .category-hero::before {
    position: absolute;
    z-index: -1;
    top: -4rem;
    right: -3rem;
    width: 12rem;
    height: 12rem;
    border: 1px solid color-mix(in oklch, var(--primary) 24%, transparent);
    border-radius: 50%;
    content: "";
    box-shadow: 0 0 0 1.2rem color-mix(in oklch, var(--primary) 5%, transparent), 0 0 4rem color-mix(in oklch, var(--primary) 18%, transparent);
  }
  .category-kicker { display: block; margin-bottom: .7rem; color: var(--primary); font-size: .68rem; font-weight: 800; letter-spacing: .18em; }
  .category-title { display: inline-flex; max-width: 100%; margin: 0; padding: .3rem .85rem .42rem; border: 1px solid color-mix(in oklch, var(--primary) 40%, var(--line-divider)); border-radius: .8rem; background: color-mix(in oklch, var(--primary) 12%, var(--card-bg)); color: var(--deep-text); font-size: clamp(1.75rem, 4vw, 2.65rem); font-weight: 850; line-height: 1.15; letter-spacing: -.025em; box-shadow: 0 .35rem 1rem color-mix(in srgb, var(--primary) 10%, transparent); }
  .category-title span { overflow-wrap: anywhere; }
  .category-description { margin: .85rem 0 0; color: color-mix(in srgb, currentColor 68%, transparent); font-size: .9rem; }
  .category-description strong { color: var(--primary); font-size: 1.05rem; }
  @media (max-width: 640px) {
    .category-title { width: 100%; }
    .category-hero { border-radius: .9rem; }
  }
</style>

# Decap CMS GitHub OAuth（仅在 astro.config.mjs 中启用 OAuth 后需要）
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Umami（仅在 twilight.config.yaml 中启用 analytics 后需要）
UMAMI_API_KEY=
UMAMI_TRACKING_CODE=

# 文章浏览、点赞与热度持久化（Vercel Marketplace / Upstash Redis）
# Vercel/Upstash 绑定后通常会自动注入其中一组变量。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 兼容旧版 Vercel KV 变量名：
KV_REST_API_URL=
KV_REST_API_TOKEN=
